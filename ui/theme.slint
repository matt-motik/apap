export global Colors {
    // Backgrounds
    in-out property <color> bg-window: #121018;
    in-out property <color> bg-surface: #1a1720;
    in-out property <color> bg-toolbar: #211e28;
    in-out property <color> bg-elevated: #252230;
    in-out property <color> bg-overlay: #00000088;

    // Borders
    in-out property <color> border-subtle: #2d2a38;
    in-out property <color> border-default: #3a3645;

    // Text
    in-out property <color> text-primary: #e6e1ec;
    in-out property <color> text-secondary: #a9a3b8;
    in-out property <color> text-tertiary: #7c7690;
    in-out property <color> text-dim: #5c5670;
    in-out property <color> text-on-accent: #ffffff;
    in-out property <color> text-error: #f2b8b5;

    // Accent
    in-out property <color> accent: #d0bcff;
    in-out property <color> accent-container: #4f378b;
    in-out property <color> accent-on: #eaddff;

    // Interactive
    in-out property <color> surface-hover: #322e3c;
    in-out property <color> surface-active: #3a2f1f;
    in-out property <color> surface-selected: #2d2a38;

    // Visualizer
    in-out property <color> viz-1: #d35400;
    in-out property <color> viz-2: #f1c40f;
    in-out property <color> viz-3: #e74c3c;
}
