import { Colors } from "theme.slint";
import { Slider, ScrollView } from "std-widgets.slint";
import { Visualizer } from "visualizer.slint";

// ADR-06, §6.19, ТЗ-50, ТЗ-55, ТЗ-61, ТЗ-118: вид индикатора замка
// устройства по LockState (LockView, src/app/lock_view.rs). Текст и
// подсказку строит Rust; Slint только выбирает значок и цвет по варианту —
// различимость без цвета обеспечивается парой «значок + текст».
export enum LockKind {
    not-applicable,
    open,
    acquiring,
    held,
    failed,
}

component VerticalSeparator inherits Rectangle {
    in property <float> gap: 12;
    width: root.gap * 2px + 1px;
    background: transparent;

    Rectangle {
        width: 1px;
        height: 100%;
        x: root.width / 2;
        background: Colors.border-default;
    }
}

component InfoRow inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "—";

    HorizontalLayout {
        spacing: 8px;
        Text {
            text: root.label;
            color: Colors.text-tertiary;
            font-size: 12px;
        }

        Text {
            text: root.value;
            color: Colors.text-primary;
            font-size: 12px;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
}

component ModeButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    in property <bool> available: true;
    in property <string> reason: "";
    callback clicked;

    height: 28px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.active ? Colors.accent : Colors.border-default;
    background: touch.pressed ? Colors.surface-hover : (root.active ? Colors.accent-container : Colors.bg-toolbar);

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        Text {
            text: root.label;
            color: !root.available ? Colors.text-dim : (root.active ? Colors.accent-on : Colors.text-primary);
            font-size: 12px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.available && !root.active;
        mouse-cursor: root.available ? MouseCursor.pointer : MouseCursor.not-allowed;
        clicked => { root.clicked(); }
    }

    // Недоступный режим не прячется через opacity (ТЗ-109, ТЗ-110): он
    // остаётся видимым и неактивным, причина всплывает подсказкой при
    // наведении курсора.
    if !root.available && touch.has-hover && root.reason != "": Rectangle {
        y: -self.height - 6px;
        x: (parent.width - self.width) / 2;
        width: 220px;
        height: hint-text.preferred-height + 12px;
        background: Colors.bg-elevated;
        border-color: Colors.border-default;
        border-width: 1px;
        border-radius: 4px;
        z: 10;

        hint-text := Text {
            text: root.reason;
            color: Colors.text-secondary;
            font-size: 11px;
            wrap: word-wrap;
            x: 8px;
            y: 6px;
            width: parent.width - 16px;
        }
    }
}

// ADR-06, §6.19, ТЗ-50, ТЗ-55, ТЗ-61, ТЗ-118: компактный индикатор замка
// устройства — значок + текст из LockView, видимый и в Совместимом режиме
// (ТЗ-50: not-applicable не прячется, только притушен). Действия (ТЗ-46,
// ТЗ-144) и коллбэки добавятся следующим шагом.
component LockIndicator inherits Rectangle {
    in property <LockKind> kind: LockKind.not-applicable;
    in property <string> text: "";
    in property <string> hint: "";

    private property <bool> active: root.kind != LockKind.not-applicable;
    // Значок по варианту, без опоры на цвет (ТЗ-55, ТЗ-61): «–» замок не
    // нужен, «○» открыт, «◐» захват, «●» закрыт (захвачен), «✕» не удалось
    // захватить.
    private property <string> glyph: root.kind == LockKind.not-applicable ? "–"
        : root.kind == LockKind.open ? "○"
        : root.kind == LockKind.acquiring ? "◐"
        : root.kind == LockKind.held ? "●"
        : "✕";
    private property <color> tint: root.kind == LockKind.held ? Colors.accent
        : root.kind == LockKind.failed ? Colors.text-warn
        : root.kind == LockKind.not-applicable ? Colors.text-dim
        : Colors.text-secondary;

    height: 28px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.active ? Colors.border-default : Colors.border-subtle;
    background: Colors.bg-toolbar;
    opacity: root.active ? 1.0 : 0.6;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        alignment: center;
        Text {
            text: root.glyph;
            color: root.tint;
            font-size: 13px;
            vertical-alignment: center;
        }
        if root.text != "": Text {
            text: root.text;
            color: root.tint;
            font-size: 12px;
            vertical-alignment: center;
        }
    }

    // Подсказка замка (ТЗ-50 — почему недоступен в Совместимом режиме;
    // ТЗ-121 — куда уходит звук других приложений при Held).
    if root.hint != "": Tooltip {
        Rectangle {
            width: 220px;
            height: lock-hint-text.preferred-height + 10px;
            background: Colors.bg-elevated;
            border-color: Colors.border-default;
            border-width: 1px;
            border-radius: 4px;

            lock-hint-text := Text {
                text: root.hint;
                color: Colors.text-secondary;
                font-size: 11px;
                wrap: word-wrap;
                x: 6px;
                y: 5px;
                width: parent.width - 12px;
            }
        }
    }
}

// ADR-06, §6.19, ТЗ-46, ТЗ-120…ТЗ-123, ТЗ-144: компактная кнопка действия
// замка (Захватить / Открыть / Повторить захват / Выбрать устройство /
// Перейти в Совместимый режим). Доступность каждого действия решает Rust
// (lock_view.rs) по состоянию автомата §6.19 — кнопка рисуется, только
// когда действие применимо, без заглушек и пустых коллбэков (ТЗ-109).
component LockActionButton inherits Rectangle {
    in property <string> label: "";
    callback clicked;

    height: 28px;
    border-radius: 6px;
    border-width: 1px;
    border-color: Colors.border-default;
    background: touch.pressed ? Colors.surface-hover : Colors.bg-toolbar;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;
        Text {
            text: root.label;
            color: Colors.text-primary;
            font-size: 12px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

component IconButton inherits Rectangle {
    in property <image> icon: @image-url("icons/play.svg");
    in property <bool> active: false;
    in property <bool> enabled: true;
    in property <brush> active-bg: Colors.accent-container;
    callback clicked;

    width: 34px;
    height: 34px;
    border-radius: 6px;
    background: touch.pressed ? Colors.surface-hover : (root.active ? root.active-bg : Colors.bg-toolbar);

    Image {
        source: root.icon;
        width: 20px;
        height: 20px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        opacity: root.enabled ? 1.0 : 0.4;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component TopPanel inherits Rectangle {
    in property <float> cover-size: 200;
    in property <float> col-info-w: 240;
    in property <float> col-gap: 12;
    in property <image> cover-art;
    in property <int> theme-palette: 0;

    in property <bool> playing: false;
    in property <bool> repeat: false;
    in property <bool> repeat-one: false;
    in property <bool> shuffle: false;
    in property <bool> muted: false;
    // ADR-14, ТЗ-35, ТЗ-37: значение приходит только из Rust (`set_volume` после
    // каждой команды); привязка к ползунку двусторонняя, чтобы перетаскивание
    // её не разрывало.
    in-out property <float> volume: 0.8;
    // ТЗ-41, ADR-23, §6.18: громкость задана активным режимом (не bit-perfect) —
    // программный слайдер блокируется, мьют остаётся доступен.
    in property <bool> volume-enabled: true;
    // ТЗ-39, ADR-14, §2.13: текст подсказки недоступной громкости (Строгий
    // режим; Оптимальный с фиксацией на 100 %). Пустая строка — громкость
    // доступна, подсказки нет.
    in property <string> volume-block-text: "";
    // Переключатель режимов (ТЗ-18, ТЗ-109, ТЗ-110): постоянно виден в
    // главном окне. active-mode — 0 Совместимый, 1 Оптимальный, 2 Строгий.
    // mode-available/mode-unavailable-reason — по индексу режима; пустая
    // причина означает доступный режим.
    in property <int> active-mode: 0;
    in property <[bool]> mode-available: [true, true, true];
    in property <[string]> mode-unavailable-reason: ["", "", ""];
    private property <[string]> mode-labels: ["Совместимый", "Оптимальный", "Строгий"];
    callback select-mode(int);
    // Bit-perfect (Direct Output): программные ползунки громкости/мьюта
    // блокируются, тракт идёт в ЦАП без пересчёта сэмплов.
    in property <bool> bit-perfect: false;
    // ADR-06, §6.19, ТЗ-50, ТЗ-118: вид индикатора замка устройства
    // (LockView, src/app/lock_view.rs) — значок/цвет выбирает Slint по
    // lock-kind, текст и подсказку строит Rust.
    in property <LockKind> lock-kind: LockKind.not-applicable;
    in property <string> lock-text: "";
    in property <string> lock-hint: "";
    // ADR-06, §6.19, ТЗ-46, ТЗ-120…ТЗ-123, ТЗ-144: доступность действий
    // замка решает Rust (lock_view.rs) по состоянию автомата §6.19 —
    // кнопка рисуется только когда флаг true, остальные скрыты полностью.
    in property <bool> lock-can-close: false;
    in property <bool> lock-can-open: false;
    in property <bool> lock-can-retry: false;
    in property <bool> lock-can-choose-device: false;
    in property <bool> lock-can-go-compatible: false;
    callback lock-close();
    callback lock-open();
    callback lock-retry();
    callback lock-choose-device();
    callback lock-go-compatible();
    in property <float> seek-fraction: 0.0;
    out property <bool> seekbar-dragging: false;
    in property <string> pos: "0:00";
    in property <string> dur: "0:00";

    private property <bool> seek-dragging: false;
    private property <float> pending-seek: -1;

    in property <string> info-artist: "—";
    in property <string> info-track: "—";
    in property <string> info-title: "—";
    in property <string> info-duration: "—";
    in property <string> info-year: "—";
    in property <string> info-album: "—";
    in property <string> info-disc: "—";
    in property <string> info-genre: "—";
    in property <string> info-format: "—";
    in property <string> info-bitrate: "—";
    in property <string> info-bit-depth: "—";
    in property <string> info-sample-rate: "—";
    in property <string> info-channels: "—";
    in property <[string]> info-labels: [
        "Artist",
        "Track",
        "Title",
        "Duration",
        "Year",
        "Album",
        "Disc",
        "Genre",
        "Format",
        "Bitrate",
        "Bit depth",
        "Sample rate",
        "Channels"
    ];

    in property <int> viz-mode: 0;
    in property <float> build-progress: 0.0;
    in property <image> osc-image: @image-url("");
    in property <bool> osc-ready: false;
    in property <string> disabled-text: ""; // спец-плейсхолдер (§6.3/6.4)

    // Анализатор спектра (режим 3): данные и параметры отрисовки полос.
    in property <[float]> spectrum-l: [];
    in property <[float]> spectrum-r: [];
    in property <int> viz-channels: 2;
    in property <float> bar-gap: 2;
    in property <float> bar-radius: 2;
    in property <bool> gradient: true;

    callback play-pause();
    callback stop();
    callback prev-track();
    callback next-track();
    callback toggle-repeat();
    callback toggle-shuffle();
    callback seek(float);
    callback seek-commit(float);
    callback volume-changed(float);
    // сырой scroll-event над ползунком: (dx, dy) в логических пикселях; щелчки
    // считает модуль ввода, положительное dy — громче (ADR-8, §6.11, ТЗ-36)
    callback volume-scroll(float, float);
    callback toggle-mute();

    background: transparent;

    VerticalLayout {
        spacing: 6px;

        // ---------- Переключатель режимов (ТЗ-18) ----------
        HorizontalLayout {
            padding-left: 10px;
            padding-top: 8px;
            padding-right: 10px;
            spacing: 8px;
            alignment: start;

            for reason[i] in root.mode-unavailable-reason: ModeButton {
                label: root.mode-labels[i];
                active: root.active-mode == i;
                available: root.mode-available[i];
                reason: reason;
                clicked => { root.select-mode(i); }
            }

            LockIndicator {
                kind: root.lock-kind;
                text: root.lock-text;
                hint: root.lock-hint;
            }

            // Действия замка (ТЗ-42, ТЗ-44, ТЗ-46, ТЗ-144): «Захватить» —
            // ручное закрытие (UserClose), «Открыть» — освобождение
            // (UserOpen), «Повторить захват» (RetryCapture) и «Выбрать
            // устройство» / «Перейти в Совместимый режим» для состояния
            // «не удалось захватить» (§6.19). Rust-обработчики — шаг 70.
            if root.lock-can-close: LockActionButton {
                label: "Захватить";
                clicked => { root.lock-close(); }
            }
            if root.lock-can-open: LockActionButton {
                label: "Открыть";
                clicked => { root.lock-open(); }
            }
            if root.lock-can-retry: LockActionButton {
                label: "Повторить захват";
                clicked => { root.lock-retry(); }
            }
            if root.lock-can-choose-device: LockActionButton {
                label: "Выбрать устройство";
                clicked => { root.lock-choose-device(); }
            }
            if root.lock-can-go-compatible: LockActionButton {
                label: "Перейти в Совместимый режим";
                clicked => { root.lock-go-compatible(); }
            }
        }

        HorizontalLayout {
        spacing: 0;
        // ---------- Col 0: cover + transport ----------
        VerticalLayout {

            spacing: 0px;
            vertical-stretch: 1;

            // Cover
            VerticalLayout {
                padding-top: 10px;
                padding-left: 10px;
                padding-right: 10px;
                Rectangle {
                    width: root.cover-size * 1px;
                    height: root.cover-size * 1px;
                    border-radius: 6px;
                    clip: true;
                    background: Colors.bg-elevated;

                    Image {
                        source: root.cover-art;
                        image-fit: cover;
                        width: 100%;
                        height: 100%;
                    }

                    // Placeholder, shown while no cover is available.
                    Text {
                        text: "Album Art";
                        color: Colors.text-tertiary;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        visible: root.cover-art.width == 0;
                    }
                }
            }

            VerticalLayout {
                vertical-stretch: 1;
                Rectangle { }
            }
            // transport buttons
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                width: root.cover-size * 1px;

                spacing: 2px;
                IconButton {
                    icon: root.theme-palette == 0 ? @image-url("icons/dark/prev.svg") : @image-url("icons/light/prev.svg");
                    visible: true;
                    width: (root.cover-size * 1px - 10px) / 6;
                    height: 24px;
                    clicked => { root.prev-track(); }
                }

                IconButton {
                    icon: root.theme-palette == 0
                        ? (root.playing ? @image-url("icons/dark/pause.svg") : @image-url("icons/dark/play.svg"))
                        : (root.playing ? @image-url("icons/light/pause.svg") : @image-url("icons/light/play.svg"));
                    active: root.playing;
                    width: (root.cover-size * 1px - 10px) / 6;
                    height: 24px;
                    clicked => { root.play-pause(); }
                }

                IconButton {
                    icon: root.theme-palette == 0 ? @image-url("icons/dark/stop.svg") : @image-url("icons/light/stop.svg");
                    width: (root.cover-size * 1px - 10px) / 6;
                    height: 24px;
                    clicked => { root.stop(); }
                }

                IconButton {
                    icon: root.theme-palette == 0 ? @image-url("icons/dark/next.svg") : @image-url("icons/light/next.svg");
                    width: (root.cover-size * 1px - 10px) / 6;
                    height: 24px;
                    clicked => { root.next-track(); }
                }

                IconButton {
                    icon: root.theme-palette == 0
                        ? (root.repeat-one ? @image-url("icons/dark/repeat-one.svg") : @image-url("icons/dark/repeat.svg"))
                        : (root.repeat-one ? @image-url("icons/light/repeat-one.svg") : @image-url("icons/light/repeat.svg"));
                    active: root.repeat || root.repeat-one;
                    width: (root.cover-size * 1px - 10px) / 6;
                    height: 24px;
                    clicked => { root.toggle-repeat(); }
                }

                IconButton {
                    icon: root.theme-palette == 0 ? @image-url("icons/dark/shuffle.svg") : @image-url("icons/light/shuffle.svg");
                    active: root.shuffle;
                    width: (root.cover-size * 1px - 10px) / 6;
                    height: 24px;
                    clicked => { root.toggle-shuffle(); }
                }
            }
        }

        // vertical separator
        VerticalSeparator {
            gap: root.col-gap;
        }

        // ---------- Col 1: track info (13 fields) ----------
        Rectangle {
            width: root.col-info-w * 1px;

            ScrollView {
                VerticalLayout {
                    padding: 0px;
                    spacing: 0px;
                    InfoRow {
                        label: root.info-labels[0];
                        value: root.info-artist;
                    }

                    InfoRow {
                        label: root.info-labels[1];
                        value: root.info-track;
                    }

                    InfoRow {
                        label: root.info-labels[2];
                        value: root.info-title;
                    }

                    InfoRow {
                        label: root.info-labels[3];
                        value: root.info-duration;
                    }

                    InfoRow {
                        label: root.info-labels[4];
                        value: root.info-year;
                    }

                    InfoRow {
                        label: root.info-labels[5];
                        value: root.info-album;
                    }

                    InfoRow {
                        label: root.info-labels[6];
                        value: root.info-disc;
                    }

                    InfoRow {
                        label: root.info-labels[7];
                        value: root.info-genre;
                    }

                    InfoRow {
                        label: root.info-labels[8];
                        value: root.info-format;
                    }

                    InfoRow {
                        label: root.info-labels[9];
                        value: root.info-bitrate;
                    }

                    InfoRow {
                        label: root.info-labels[10];
                        value: root.info-bit-depth;
                    }

                    InfoRow {
                        label: root.info-labels[11];
                        value: root.info-sample-rate;
                    }

                    InfoRow {
                        label: root.info-labels[12];
                        value: root.info-channels;
                    }
                }
            }
        }

        VerticalSeparator {
            gap: root.col-gap;
        }

        // ---------- Col 2: visualizer + seek ----------
        VerticalLayout {
            spacing: 0px;
            horizontal-stretch: 1;
            max-width: 100000px;
            VerticalLayout {
                padding-top: 10px;
                padding-left: 10px;
                padding-right: 10px;
                Visualizer {
                    mode: root.viz-mode;
                    artist: root.info-artist;
                    album: root.info-album;
                    format: root.info-format;
                    viz-channels: root.viz-channels;
                    spectrum-l: root.spectrum-l;
                    spectrum-r: root.spectrum-r;
                    bar-gap: root.bar-gap;
                    bar-radius: root.bar-radius;
                    gradient: root.gradient;
                    build-progress: root.build-progress;
                    osc-image: root.osc-image;
                    osc-ready: root.osc-ready;
                    disabled-text: root.disabled-text;
                    seek-fraction: root.seek-fraction;
                    height: root.cover-size * 1px;
                    width: 100%;
                    seek-commit(v) => { root.seek-commit(v); }
                }
            }
                HorizontalLayout {
                    horizontal-stretch: 1;
                    padding-top: 0px;
                    padding-left: 6px;
                    padding-right: 6px;
                    Text {
                        text: root.pos;
                        color: Colors.text-tertiary;
                        font-size: 11px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                    }

                    Text {
                        text: root.dur;
                        color: Colors.text-tertiary;
                        font-size: 11px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
            VerticalLayout {
                spacing: 0px;
                alignment: center;
                horizontal-stretch: 1;
                max-height: 0px;

                seekbar := Rectangle {
                    horizontal-stretch: 1;
                    height: 24px;

                    Slider {
                        width: 100%;
                        height: 100%;
                        minimum: 0;
                        maximum: 1;
                        value: root.seek-dragging && root.pending-seek >= 0 ? root.pending-seek : root.seek-fraction;
                        changed(v) => {
                            // Программные обновления из тика (seek-fraction) идут в `seek`.
                            // Во время драга ползунком управляет touch-grab, seek — при отпускании.
                            if (!root.seek-dragging) {
                                root.seek(v);
                            }
                        }
                    }

                    // Полностью забирает управление слайдером: клик/драг позиционирует
                    // «на лету», а seek выполняется один раз при отпускании (seek-commit).
                    seekgrab := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: MouseCursor.pointer;

                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                root.seek-dragging = true;
                                root.pending-seek = Math.clamp(self.mouse-x / self.width, 0, 1);
                                root.seekbar-dragging = true;
                            } else if (event.kind == PointerEventKind.up) {
                                if (root.seek-dragging) {
                                    if (root.pending-seek >= 0) {
                                        root.seek-commit(root.pending-seek);
                                    }
                                    root.pending-seek = -1;
                                }
                                root.seek-dragging = false;
                                root.seekbar-dragging = false;
                            }
                        }

                        moved => {
                            if (root.seek-dragging) {
                                root.pending-seek = Math.clamp(self.mouse-x / self.width, 0, 1);
                            }
                        }
                    }
                }


            }
        }

        VerticalSeparator {
            gap: root.col-gap;
        }

        // ---------- Col 3: volume + mute ----------
        VerticalLayout {
            //padding-top: 10px;
            alignment: center;
            padding-right: 10px;

            // Верхняя часть: слайдер громкости, растягивается на всю доступную высоту
            Rectangle {
                vertical-stretch: 1;
                height: root.cover-size * 1px +20px;
                HorizontalLayout {
                    alignment: center;
                    vertical-stretch: 1;
                    wheel-vol := TouchArea {
                        vertical-stretch: 1;
                        width: 34px;
                        enabled: !root.bit-perfect && root.volume-enabled;
                        // Wheel over the slider = raw scroll offsets (dx, dy)
                        // in logical pixels, positive dy = louder. Clicks
                        // are counted by the input module, not here (ADR-8,
                        // §6.11, ТЗ-36); the step size is set by the core
                        // (ADR-14, НФ-2). Drag keeps working via the
                        // Slider's own TouchArea (scroll bubbles up here).
                        scroll-event(event) => {
                            if (event.delta-y != 0) {
                                root.volume-scroll(event.delta-x / 1px, event.delta-y / 1px);
                                return accept;
                            }
                            reject
                        }
                        HorizontalLayout {
                            alignment: center;
                            vertical-stretch: 1;
                            Slider {
                                vertical-stretch: 1;
                                width: 24px;
                                value <=> root.volume;
                                minimum: 0;
                                maximum: 1;
                                orientation: vertical;
                                enabled: !root.bit-perfect && root.volume-enabled;
                                changed(v) => { root.volume-changed(v); }
                            }
                        }
                    }
                }

                // Подсказка недоступной громкости (ТЗ-39, ADR-14, §2.13).
                // Tooltip стоит на обёртке колонки, которая сама не
                // отключается (wheel-vol и Slider отключаются отдельно), и
                // существует только при непустом тексте из Rust.
                if root.volume-block-text != "": Tooltip {
                    Rectangle {
                        width: 170px;
                        height: vol-block-tip-text.preferred-height + 10px;
                        background: Colors.bg-elevated;
                        border-color: Colors.border-default;
                        border-width: 1px;
                        border-radius: 4px;

                        vol-block-tip-text := Text {
                            text: root.volume-block-text;
                            color: Colors.text-secondary;
                            font-size: 11px;
                            wrap: word-wrap;
                            x: 6px;
                            y: 5px;
                            width: parent.width - 12px;
                        }
                    }
                }

                }
            VerticalLayout {
                vertical-stretch: 1;
                Rectangle { }
            }

            // Нижняя часть: кнопка mute такой же высоты, как панель с ползунком позиции
            HorizontalLayout {

                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;

                    // Mute доступен во всех режимах, в том числе при
                    // недоступной громкости (ТЗ-38, ADR-14).
                    IconButton {
                        icon: root.theme-palette == 0
                            ? (root.muted ? @image-url("icons/dark/muted.svg") : @image-url("icons/dark/volume.svg"))
                            : (root.muted ? @image-url("icons/light/muted.svg") : @image-url("icons/light/volume.svg"));
                        active: root.muted;
                        width: (root.cover-size * 1px - 10px) / 6;
                        height: 24px;
                        clicked => { root.toggle-mute(); }
                    }
                }
            }
        }

        VerticalLayout {
            width: root.col-gap * 1px / 2 + 1px;
        }
        }
    }

}
