// Верхняя панель (Material Design) — компактный тулбар.
// Строка 1: обложка + инфо о треке + громкость + repeat/shuffle.
// Строка 2: транспорт (prev / play / next / stop) + seek + время.
// Строка 3: спектральный эквалайзер (полоса внизу панели).
// Высота ~150px, плейлист занимает остальную высоту окна.

import { Button, Slider, Palette } from "std-widgets.slint";

// Круглая иконка-кнопка (Material-стиль): hover, нажатие, активное состояние.
component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> active: false;
    in property <length> size: 40px;
    in property <length> icon-size: 22px;
    callback clicked;

    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.active ? #37465c : (touch.has-hover ? #2c3544 : transparent);

    touch := TouchArea {
        width: root.size;
        height: root.size;
        clicked => { root.clicked(); }
    }
    Image {
        source: root.icon;
        width: root.icon-size;
        height: root.icon-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        colorize: root.active ? #ffffff : #d6deea;
    }
}

export component TopPanel inherits Rectangle {
    in property <length> cover-size: 200px;
    in property <length> info-width: 240px;
    in property <length> col-gap: 12px;
    in property <[float]> spectrum-data: [];
    in property <string> track-title: "—";
    in property <string> track-artist: "—";
    in property <string> track-album: "—";
    in property <string> pos: "0:00";
    in property <string> dur: "0:00";
    in property <float> volume: 0.8;
    in property <bool> muted: false;
    in property <bool> playing: false;
    in property <bool> repeat: false;
    in property <bool> shuffle: false;

    callback play-pause();
    callback stop();
    callback prev-track();
    callback next-track();
    callback toggle-repeat();
    callback toggle-shuffle();
    callback toggle-mute();
    callback seek(float);
    callback volume-changed(float);

    background: Palette.alternate-background;

    // Нижняя граница-разделитель панели.
    Rectangle {
        y: parent.height - 1px;
        x: 0;
        width: parent.width;
        height: 1px;
        background: Palette.border;
    }

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 8px;
        spacing: 8px;

        // ---- Строка 1: обложка + инфо + громкость + переключатели ----
        HorizontalLayout {
            height: 52px;
            spacing: 16px;
            cross-axis-alignment: center;

            Rectangle {
                width: 52px;
                height: 52px;
                border-radius: 10px;
                background: Palette.control-background;
                border-width: 1px;
                border-color: Palette.border;
                Text {
                    text: "♪";
                    color: Palette.alternate-foreground;
                    font-size: 22px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Инфо о треке.
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text {
                    text: track-title;
                    color: Palette.foreground;
                    font-size: 16px;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: track-artist == "—" ? track-album : track-artist;
                    color: Palette.alternate-foreground;
                    font-size: 13px;
                    overflow: elide;
                }
            }

            // Громкость: mute-иконка + слайдер.
            HorizontalLayout {
                width: 150px;
                spacing: 8px;
                cross-axis-alignment: center;
                IconButton {
                    icon: muted
                        ? @image-url("icons/muted.svg")
                        : @image-url("icons/volume.svg");
                    size: 34px;
                    icon-size: 18px;
                    active: muted;
                    clicked => root.toggle-mute();
                }
                Slider {
                    horizontal-stretch: 1;
                    minimum: 0;
                    maximum: 100;
                    value: volume * 100;
                    changed(v) => { root.volume-changed(v / 100.0); }
                }
            }

            IconButton {
                icon: @image-url("icons/repeat.svg");
                active: repeat;
                size: 38px;
                icon-size: 21px;
                clicked => root.toggle-repeat();
            }
            IconButton {
                icon: @image-url("icons/shuffle.svg");
                active: shuffle;
                size: 38px;
                icon-size: 21px;
                clicked => root.toggle-shuffle();
            }
        }

        // ---- Строка 2: транспорт + seek + время ----
        HorizontalLayout {
            height: 48px;
            spacing: 12px;
            cross-axis-alignment: center;

            IconButton {
                icon: @image-url("icons/prev.svg");
                size: 40px;
                icon-size: 22px;
                clicked => root.prev-track();
            }

            // Главная кнопка — заполненная акцентная (Material Filled).
            Button {
                icon: playing
                    ? @image-url("icons/pause.svg")
                    : @image-url("icons/play.svg");
                primary: true;
                colorize-icon: true;
                icon-size: 24px;
                width: 52px;
                height: 52px;
                clicked => root.play-pause();
            }

            IconButton {
                icon: @image-url("icons/next.svg");
                size: 40px;
                icon-size: 22px;
                clicked => root.next-track();
            }
            IconButton {
                icon: @image-url("icons/stop.svg");
                size: 36px;
                icon-size: 20px;
                clicked => root.stop();
            }

            Slider {
                horizontal-stretch: 1;
                minimum: 0.0;
                maximum: 1.0;
                value: 0.0;
                changed(v) => { root.seek(v); }
            }

            Text { text: pos; color: Palette.alternate-foreground; font-size: 12px; }
            Text { text: " / "; color: Palette.alternate-foreground; font-size: 12px; }
            Text { text: dur; color: Palette.alternate-foreground; font-size: 12px; }
        }

        // ---- Строка 3: спектральный эквалайзер ----
        spectrumArea := Rectangle {
            height: 24px;
            horizontal-stretch: 1;
            clip: true;
            HorizontalLayout {
                alignment: center;
                cross-axis-alignment: end;
                spacing: 2px;
                for mag in root.spectrum-data: Rectangle {
                    height: max(3px, spectrumArea.height * mag);
                    horizontal-stretch: 1;
                    max-width: 3px;
                    border-radius: 1.5px;
                    background: @linear-gradient(180deg, #2dd4a7 0%, #4d9bff 60%, #7c6bff 100%);
                }
            }
        }
    }
}
