import { Colors } from "theme.slint";
import { Slider, ScrollView } from "std-widgets.slint";
import { Visualizer } from "visualizer.slint";

// ADR-06, §6.19, ТЗ-50, ТЗ-55, ТЗ-61, ТЗ-118: вид индикатора замка
// устройства по LockState (LockView, src/app/lock_view.rs). Текст и
// подсказку строит Rust; Slint только выбирает значок и цвет по варианту —
// различимость без цвета обеспечивается парой «значок + текст».
export enum LockKind {
    not-applicable,
    open,
    acquiring,
    held,
    failed,
}

component VerticalSeparator inherits Rectangle {
    in property <float> gap: 12;
    width: root.gap * 2px + 1px;
    background: transparent;

    Rectangle {
        width: 1px;
        height: 100%;
        x: root.width / 2;
        background: Colors.border-default;
    }
}

component InfoRow inherits Rectangle {
    in property <string> label: "";
    in property <string> value: "—";

    HorizontalLayout {
        spacing: 8px;
        Text {
            text: root.label;
            color: Colors.text-tertiary;
            font-size: 12px;
        }

        Text {
            text: root.value;
            color: Colors.text-primary;
            font-size: 12px;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
}

component ModeButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    in property <bool> available: true;
    in property <string> reason: "";
    callback clicked;

    height: 28px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.active ? Colors.accent : Colors.border-default;
    background: touch.pressed ? Colors.surface-hover : (root.active ? Colors.accent-container : Colors.bg-toolbar);

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        Text {
            text: root.label;
            color: !root.available ? Colors.text-dim : (root.active ? Colors.accent-on : Colors.text-primary);
            font-size: 12px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.available && !root.active;
        mouse-cursor: root.available ? MouseCursor.pointer : MouseCursor.not-allowed;
        clicked => { root.clicked(); }
    }

    // Недоступный режим не прячется через opacity (ТЗ-109, ТЗ-110): он
    // остаётся видимым и неактивным, причина всплывает подсказкой при
    // наведении курсора.
    if !root.available && touch.has-hover && root.reason != "": Rectangle {
        y: -self.height - 6px;
        x: (parent.width - self.width) / 2;
        width: 220px;
        height: hint-text.preferred-height + 12px;
        background: Colors.bg-elevated;
        border-color: Colors.border-default;
        border-width: 1px;
        border-radius: 4px;
        z: 10;

        hint-text := Text {
            text: root.reason;
            color: Colors.text-secondary;
            font-size: 11px;
            wrap: word-wrap;
            x: 8px;
            y: 6px;
            width: parent.width - 16px;
        }
    }
}

// ADR-06, §6.19, ТЗ-44, ТЗ-46, ТЗ-50, ТЗ-55, ТЗ-61, ТЗ-118, ТЗ-119, ТЗ-121,
// ТЗ-144 (решение пользователя 2026-10-23 — редизайн): кнопка-значок замка
// устройства без подписи. Вид (значок, цвет не несёт смысла — различимость
// формой) выбирает Slint по `kind`; текст и подсказку строит Rust
// (LockView, src/app/lock_view.rs). Скрыта в Совместимом режиме (ТЗ-50);
// во время захвата — значок песочных часов, кнопка недоступна; в Open
// (включая отказ захвата — замок остаётся визуально «открыт», ТЗ-46) клик
// вызывает `close` (захват/повтор), в Held — `open` (освобождение, ТЗ-44).
// Причина отказа и действия по ней — отдельное окно ошибки (AM1.0-B14 шаг
// 5), не эта кнопка.
component LockButton inherits Rectangle {
    in property <LockKind> kind: LockKind.not-applicable;
    in property <string> text: "";
    in property <string> hint: "";
    in property <int> theme-palette: 0;
    callback close();
    callback open();

    private property <bool> dark: root.theme-palette == 0;
    private property <bool> acquiring: root.kind == LockKind.acquiring;
    private property <bool> held: root.kind == LockKind.held;
    // Подсказка при наведении — текст состояния (ТЗ-119) и, если он несёт
    // что-то сверх текста (ТЗ-121 — перенаправление звука в Held), подсказка
    // отдельной строкой.
    private property <string> tooltip-text: root.hint == "" || root.hint == root.text
        ? root.text
        : (root.text == "" ? root.hint : root.text + "\n" + root.hint);
    private property <image> icon: root.held
        ? (root.dark ? @image-url("icons/dark/lock-closed.svg") : @image-url("icons/light/lock-closed.svg"))
        : root.acquiring
            ? (root.dark ? @image-url("icons/dark/hourglass.svg") : @image-url("icons/light/hourglass.svg"))
            : (root.dark ? @image-url("icons/dark/lock-open.svg") : @image-url("icons/light/lock-open.svg"));

    visible: root.kind != LockKind.not-applicable;
    width: root.visible ? 24px : 0px;
    height: 24px;
    border-radius: 6px;
    background: !touch.enabled ? transparent : (touch.pressed ? Colors.surface-hover : (touch.has-hover ? Colors.bg-elevated : Colors.bg-toolbar));

    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: touch.enabled;
    accessible-action-default => { touch.clicked(); }

    // Анимация ожидания (ТЗ-119) — дёшево: таймер переключает прозрачность
    // значка, плавность даёт только `animate` на уже существующем свойстве
    // (без доп. перерисовки формы/поворота).
    private property <bool> pulse-tick: false;
    Timer {
        interval: 650ms;
        running: root.acquiring;
        triggered => { root.pulse-tick = !root.pulse-tick; }
    }

    icon-image := Image {
        source: root.icon;
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        opacity: !touch.enabled && !root.acquiring ? 0.4 : (root.acquiring ? (root.pulse-tick ? 1.0 : 0.5) : 1.0);
        animate opacity { duration: 550ms; easing: ease-in-out; }
    }

    touch := TouchArea {
        enabled: !root.acquiring;
        mouse-cursor: touch.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            if (root.held) {
                root.open();
            } else {
                root.close();
            }
        }
    }

    // Подсказка замка (AM1.0-B14 шаг 14, ТЗ-119, ТЗ-121): свой попап
    // вместо встроенного `Tooltip` — у его лаунчера (TooltipArea,
    // builtins.slint) в 1.17/1.18 нет публичных delay/offset, а кнопка
    // стоит у самого края окна, где фиксированная позиция «у курсора»
    // обрезается рамкой экрана. Показ — после 700 мс непрерывного
    // наведения (root.hover-ms, тик каждые 50 мс); скрытие — сразу при
    // уходе курсора (условие ниже проверяет touch.has-hover напрямую, не
    // только защёлку show-tooltip). Позиция: правый край подсказки
    // совпадает с правым краем кнопки, а кнопка уже прижата к правому
    // краю окна отступом ≥ 10px контейнером (MenuBarTrailing —
    // app.slint padding-right 12px / top_panel.slint 10px), поэтому
    // подсказка остаётся внутри окна без знания его ширины.
    private property <int> hover-ms: 0;
    private property <bool> show-tooltip: false;
    Timer {
        interval: 50ms;
        running: true;
        triggered => {
            if (touch.has-hover) {
                root.hover-ms += 50;
            } else {
                root.hover-ms = 0;
            }
            root.show-tooltip = root.hover-ms >= 700;
        }
    }

    if root.tooltip-text != "" && touch.has-hover && root.show-tooltip: Rectangle {
        x: root.width - self.width;
        y: root.height + 4px;
        width: 220px;
        height: lock-tip-text.preferred-height + 10px;
        background: Colors.bg-elevated;
        border-color: Colors.border-default;
        border-width: 1px;
        border-radius: 4px;
        z: 10;

        lock-tip-text := Text {
            text: root.tooltip-text;
            color: Colors.text-secondary;
            font-size: 11px;
            wrap: word-wrap;
            x: 6px;
            y: 5px;
            width: parent.width - 12px;
        }
    }
}

// ADR-06, §6.19, AM1.0-B14 шаг 8 (AM1.0-B4, AM1.0-B30): контейнер у правого
// края строки меню — пока только кнопка замка; будущая группа
// «режим ▾ · устройство» встаёт здесь же, слева от неё (новые элементы
// добавляются ПЕРЕД LockButton, выравнивание `end` сохраняет замок крайним
// справа). Используется дважды в зависимости от `menu-bar-in-window`
// (ui/app.slint): оверлеем над встроенным MenuBar (Linux/Windows) или здесь,
// в TopPanel, у правого края верхней панели (macOS, системный NSMenu).
export component MenuBarTrailing inherits HorizontalLayout {
    in property <LockKind> lock-kind: LockKind.not-applicable;
    in property <string> lock-text: "";
    in property <string> lock-hint: "";
    in property <int> theme-palette: 0;
    // AM1.0-B30 шаг 3: ярлык фактически открытого устройства — та же
    // подпись, что в DeviceInfoView.now_line (src/app/device_info_view.rs),
    // без приставки «Сейчас: ● … —»; "" — ничего не открыто, бейдж скрыт
    // целиком (без «—», решение шага). Будущий бейдж режима (AM1.0-B4)
    // встаёт здесь же, перед DeviceBadge (слева от него).
    in property <string> device-label: "";
    callback lock-close();
    callback lock-open();

    alignment: end;
    spacing: 8px;

    if root.device-label != "": Text {
        text: root.device-label;
        color: Colors.text-tertiary;
        font-size: 11px;
        vertical-alignment: center;
        overflow: elide;
        max-width: 240px;

        Tooltip {
            text: @markdown("\{root.device-label}");
        }
    }

    LockButton {
        kind: root.lock-kind;
        text: root.lock-text;
        hint: root.lock-hint;
        theme-palette: root.theme-palette;
        close => { root.lock-close(); }
        open => { root.lock-open(); }
    }
}

component IconButton inherits Rectangle {
    in property <image> icon: @image-url("icons/play.svg");
    in property <bool> active: false;
    in property <bool> enabled: true;
    in property <brush> active-bg: Colors.accent-container;
    callback clicked;

    width: 34px;
    height: 34px;
    border-radius: 6px;
    background: touch.pressed ? Colors.surface-hover : (root.active ? root.active-bg : Colors.bg-toolbar);

    Image {
        source: root.icon;
        width: 20px;
        height: 20px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        opacity: root.enabled ? 1.0 : 0.4;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component TopPanel inherits Rectangle {
    in property <float> cover-size: 200;
    in property <float> col-info-w: 240;
    in property <float> col-gap: 12;
    in property <image> cover-art;
    in property <int> theme-palette: 0;

    in property <bool> playing: false;
    in property <bool> repeat: false;
    in property <bool> repeat-one: false;
    in property <bool> shuffle: false;
    in property <bool> muted: false;
    // ADR-14, ТЗ-35, ТЗ-37: значение приходит только из Rust (`set_volume` после
    // каждой команды); привязка к ползунку двусторонняя, чтобы перетаскивание
    // её не разрывало.
    in-out property <float> volume: 0.8;
    // ТЗ-41, ADR-23, §6.18: громкость задана активным режимом (не bit-perfect) —
    // программный слайдер блокируется, мьют остаётся доступен.
    in property <bool> volume-enabled: true;
    // ТЗ-39, ADR-14, §2.13: текст подсказки недоступной громкости (Строгий
    // режим; Оптимальный с фиксацией на 100 %). Пустая строка — громкость
    // доступна, подсказки нет.
    in property <string> volume-block-text: "";
    // Переключатель режимов (ТЗ-18, ТЗ-109, ТЗ-110): постоянно виден в
    // главном окне. active-mode — 0 Совместимый, 1 Оптимальный, 2 Строгий.
    // mode-available/mode-unavailable-reason — по индексу режима; пустая
    // причина означает доступный режим.
    in property <int> active-mode: 0;
    in property <[bool]> mode-available: [true, true, true];
    in property <[string]> mode-unavailable-reason: ["", "", ""];
    private property <[string]> mode-labels: [@tr("Совместимый"), @tr("Оптимальный"), @tr("Строгий")];
    callback select-mode(int);
    // Bit-perfect (Direct Output): программные ползунки громкости/мьюта
    // блокируются, тракт идёт в ЦАП без пересчёта сэмплов.
    in property <bool> bit-perfect: false;
    // ADR-06, §6.19, ТЗ-44, ТЗ-46, ТЗ-50, ТЗ-118, ТЗ-119, ТЗ-121, ТЗ-144:
    // кнопка-значок замка устройства (LockButton) — вид выбирает Slint по
    // lock-kind, текст и подсказку строит Rust (LockView,
    // src/app/lock_view.rs). Клик сам выбирает lock-close/lock-open по
    // kind; набор кнопок окна ошибки по причине отказа — отдельное окно
    // (AM1.0-B14 шаг 5), не эта кнопка.
    in property <LockKind> lock-kind: LockKind.not-applicable;
    in property <string> lock-text: "";
    in property <string> lock-hint: "";
    // AM1.0-B30 шаг 3: ярлык бейджа открытого устройства (MenuBarTrailing) —
    // проброс дальше, сам TopPanel текст не строит.
    in property <string> device-label: "";
    callback lock-close();
    callback lock-open();
    // AM1.0-B14 шаг 8: true — строка меню встроена в окно (Linux/Windows,
    // MenuBarTrailing — оверлей над ней в ui/app.slint, здесь не рендерится);
    // false — строка меню системная (macOS, NSMenu), MenuBarTrailing встаёт
    // у правого края этой панели ниже. Значение приходит из AppWindow, та
    // выставляет его из Rust (`cfg!(target_os = "macos")`, src/app/mod.rs).
    in property <bool> menu-bar-in-window: true;
    in property <float> seek-fraction: 0.0;
    out property <bool> seekbar-dragging: false;
    in property <string> pos: "0:00";
    in property <string> dur: "0:00";

    private property <bool> seek-dragging: false;
    private property <float> pending-seek: -1;

    in property <string> info-artist: "—";
    in property <bool> info-has-track: false;
    in property <string> info-track: "—";
    in property <string> info-title: "—";
    in property <string> info-duration: "—";
    in property <string> info-year: "—";
    in property <string> info-album: "—";
    in property <string> info-disc: "—";
    in property <string> info-genre: "—";
    in property <string> info-format: "—";
    in property <string> info-bitrate: "—";
    in property <string> info-bit-depth: "—";
    in property <string> info-sample-rate: "—";
    in property <string> info-channels: "—";
    in property <[string]> info-labels: [
        @tr("Исполнитель"),
        @tr("Трек"),
        @tr("Название"),
        @tr("Длительность"),
        @tr("Год"),
        @tr("Альбом"),
        @tr("Диск"),
        @tr("Жанр"),
        @tr("Формат"),
        @tr("Битрейт"),
        @tr("Разрядность"),
        @tr("Частота дискретизации"),
        @tr("Каналы")
    ];

    in property <int> viz-mode: 0;
    in property <float> build-progress: 0.0;
    in property <image> osc-image: @image-url("");
    in property <bool> osc-ready: false;
    in property <string> disabled-text: ""; // спец-плейсхолдер (§6.3/6.4)

    // Анализатор спектра (режим 3): данные и параметры отрисовки полос.
    in property <[float]> spectrum-l: [];
    in property <[float]> spectrum-r: [];
    in property <int> viz-channels: 2;
    in property <float> bar-gap: 2;
    in property <float> bar-radius: 2;
    in property <bool> gradient: true;

    callback play-pause();
    callback stop();
    callback prev-track();
    callback next-track();
    callback toggle-repeat();
    callback toggle-shuffle();
    callback seek(float);
    callback seek-commit(float);
    callback volume-changed(float);
    // сырой scroll-event над ползунком: (dx, dy) в логических пикселях; щелчки
    // считает модуль ввода, положительное dy — громче (ADR-8, §6.11, ТЗ-36)
    callback volume-scroll(float, float);
    callback toggle-mute();

    background: transparent;

    VerticalLayout {
        spacing: 6px;

        // ---------- Переключатель режимов (ТЗ-18) ----------
        HorizontalLayout {
            padding-left: 10px;
            padding-top: 8px;
            padding-right: 10px;
            spacing: 8px;
            alignment: start;

            for reason[i] in root.mode-unavailable-reason: ModeButton {
                label: root.mode-labels[i];
                active: root.active-mode == i;
                available: root.mode-available[i];
                reason: reason;
                clicked => { root.select-mode(i); }
            }

            // AM1.0-B14 шаг 8: на macOS (menu-bar-in-window: false, строка
            // меню — системный NSMenu) группа «режим ▾ · устройство · замок»
            // стоит у правого края этой панели, не оверлеем над строкой меню
            // (ui/app.slint — для Linux/Windows, где MenuBar встроен в окно).
            if !root.menu-bar-in-window: Rectangle {
                horizontal-stretch: 1;
            }

            if !root.menu-bar-in-window: MenuBarTrailing {
                lock-kind: root.lock-kind;
                lock-text: root.lock-text;
                lock-hint: root.lock-hint;
                theme-palette: root.theme-palette;
                device-label: root.device-label;
                lock-close => { root.lock-close(); }
                lock-open => { root.lock-open(); }
            }
        }

        HorizontalLayout {
        spacing: 0;
        // ---------- Col 0: cover + transport ----------
        VerticalLayout {

            spacing: 0px;
            vertical-stretch: 1;

            // Cover
            VerticalLayout {
                padding-top: 10px;
                padding-left: 10px;
                padding-right: 10px;
                Rectangle {
                    width: root.cover-size * 1px;
                    height: root.cover-size * 1px;
                    border-radius: 6px;
                    clip: true;
                    background: Colors.bg-elevated;

                    Image {
                        source: root.cover-art;
                        image-fit: cover;
                        width: 100%;
                        height: 100%;
                    }

                    // Placeholder, shown while no cover is available.
                    Text {
                        text: @tr("Обложка альбома");
                        color: Colors.text-tertiary;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        visible: root.cover-art.width == 0;
                    }
                }
            }

            VerticalLayout {
                vertical-stretch: 1;
                Rectangle { }
            }
            // transport buttons
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                width: root.cover-size * 1px;

                spacing: 2px;
                IconButton {
                    icon: root.theme-palette == 0 ? @image-url("icons/dark/prev.svg") : @image-url("icons/light/prev.svg");
                    visible: true;
                    width: (root.cover-size * 1px - 10px) / 6;
                    height: 24px;
                    clicked => { root.prev-track(); }
                }

                IconButton {
                    icon: root.theme-palette == 0
                        ? (root.playing ? @image-url("icons/dark/pause.svg") : @image-url("icons/dark/play.svg"))
                        : (root.playing ? @image-url("icons/light/pause.svg") : @image-url("icons/light/play.svg"));
                    active: root.playing;
                    width: (root.cover-size * 1px - 10px) / 6;
                    height: 24px;
                    clicked => { root.play-pause(); }
                }

                IconButton {
                    icon: root.theme-palette == 0 ? @image-url("icons/dark/stop.svg") : @image-url("icons/light/stop.svg");
                    width: (root.cover-size * 1px - 10px) / 6;
                    height: 24px;
                    clicked => { root.stop(); }
                }

                IconButton {
                    icon: root.theme-palette == 0 ? @image-url("icons/dark/next.svg") : @image-url("icons/light/next.svg");
                    width: (root.cover-size * 1px - 10px) / 6;
                    height: 24px;
                    clicked => { root.next-track(); }
                }

                IconButton {
                    icon: root.theme-palette == 0
                        ? (root.repeat-one ? @image-url("icons/dark/repeat-one.svg") : @image-url("icons/dark/repeat.svg"))
                        : (root.repeat-one ? @image-url("icons/light/repeat-one.svg") : @image-url("icons/light/repeat.svg"));
                    active: root.repeat || root.repeat-one;
                    width: (root.cover-size * 1px - 10px) / 6;
                    height: 24px;
                    clicked => { root.toggle-repeat(); }
                }

                IconButton {
                    icon: root.theme-palette == 0 ? @image-url("icons/dark/shuffle.svg") : @image-url("icons/light/shuffle.svg");
                    active: root.shuffle;
                    width: (root.cover-size * 1px - 10px) / 6;
                    height: 24px;
                    clicked => { root.toggle-shuffle(); }
                }
            }
        }

        // vertical separator
        VerticalSeparator {
            gap: root.col-gap;
        }

        // ---------- Col 1: track info (13 fields) ----------
        Rectangle {
            width: root.col-info-w * 1px;

            ScrollView {
                VerticalLayout {
                    padding: 0px;
                    spacing: 0px;
                    InfoRow {
                        label: root.info-labels[0];
                        value: root.info-artist;
                    }

                    InfoRow {
                        label: root.info-labels[1];
                        value: root.info-track;
                    }

                    InfoRow {
                        label: root.info-labels[2];
                        value: root.info-title;
                    }

                    InfoRow {
                        label: root.info-labels[3];
                        value: root.info-duration;
                    }

                    InfoRow {
                        label: root.info-labels[4];
                        value: root.info-year;
                    }

                    InfoRow {
                        label: root.info-labels[5];
                        value: root.info-album;
                    }

                    InfoRow {
                        label: root.info-labels[6];
                        value: root.info-disc;
                    }

                    InfoRow {
                        label: root.info-labels[7];
                        value: root.info-genre;
                    }

                    InfoRow {
                        label: root.info-labels[8];
                        value: root.info-format;
                    }

                    InfoRow {
                        label: root.info-labels[9];
                        value: root.info-bitrate;
                    }

                    InfoRow {
                        label: root.info-labels[10];
                        value: root.info-bit-depth;
                    }

                    InfoRow {
                        label: root.info-labels[11];
                        value: root.info-sample-rate;
                    }

                    InfoRow {
                        label: root.info-labels[12];
                        value: root.info-channels;
                    }
                }
            }
        }

        VerticalSeparator {
            gap: root.col-gap;
        }

        // ---------- Col 2: visualizer + seek ----------
        VerticalLayout {
            spacing: 0px;
            horizontal-stretch: 1;
            max-width: 100000px;
            VerticalLayout {
                padding-top: 10px;
                padding-left: 10px;
                padding-right: 10px;
                Visualizer {
                    mode: root.viz-mode;
                    artist: root.info-artist;
                    has-track: root.info-has-track;
                    album: root.info-album;
                    format: root.info-format;
                    viz-channels: root.viz-channels;
                    spectrum-l: root.spectrum-l;
                    spectrum-r: root.spectrum-r;
                    bar-gap: root.bar-gap;
                    bar-radius: root.bar-radius;
                    gradient: root.gradient;
                    build-progress: root.build-progress;
                    osc-image: root.osc-image;
                    osc-ready: root.osc-ready;
                    disabled-text: root.disabled-text;
                    seek-fraction: root.seek-fraction;
                    height: root.cover-size * 1px;
                    width: 100%;
                    seek-commit(v) => { root.seek-commit(v); }
                }
            }
                HorizontalLayout {
                    horizontal-stretch: 1;
                    padding-top: 0px;
                    padding-left: 6px;
                    padding-right: 6px;
                    Text {
                        text: root.pos;
                        color: Colors.text-tertiary;
                        font-size: 11px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                    }

                    Text {
                        text: root.dur;
                        color: Colors.text-tertiary;
                        font-size: 11px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
            VerticalLayout {
                spacing: 0px;
                alignment: center;
                horizontal-stretch: 1;
                max-height: 0px;

                seekbar := Rectangle {
                    horizontal-stretch: 1;
                    height: 24px;

                    Slider {
                        width: 100%;
                        height: 100%;
                        minimum: 0;
                        maximum: 1;
                        value: root.seek-dragging && root.pending-seek >= 0 ? root.pending-seek : root.seek-fraction;
                        changed(v) => {
                            // Программные обновления из тика (seek-fraction) идут в `seek`.
                            // Во время драга ползунком управляет touch-grab, seek — при отпускании.
                            if (!root.seek-dragging) {
                                root.seek(v);
                            }
                        }
                    }

                    // Полностью забирает управление слайдером: клик/драг позиционирует
                    // «на лету», а seek выполняется один раз при отпускании (seek-commit).
                    seekgrab := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: MouseCursor.pointer;

                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                root.seek-dragging = true;
                                root.pending-seek = Math.clamp(self.mouse-x / self.width, 0, 1);
                                root.seekbar-dragging = true;
                            } else if (event.kind == PointerEventKind.up) {
                                if (root.seek-dragging) {
                                    if (root.pending-seek >= 0) {
                                        root.seek-commit(root.pending-seek);
                                    }
                                    root.pending-seek = -1;
                                }
                                root.seek-dragging = false;
                                root.seekbar-dragging = false;
                            }
                        }

                        moved => {
                            if (root.seek-dragging) {
                                root.pending-seek = Math.clamp(self.mouse-x / self.width, 0, 1);
                            }
                        }
                    }
                }


            }
        }

        VerticalSeparator {
            gap: root.col-gap;
        }

        // ---------- Col 3: volume + mute ----------
        VerticalLayout {
            //padding-top: 10px;
            alignment: center;
            padding-right: 10px;

            // Верхняя часть: слайдер громкости, растягивается на всю доступную высоту
            Rectangle {
                vertical-stretch: 1;
                height: root.cover-size * 1px +20px;
                HorizontalLayout {
                    alignment: center;
                    vertical-stretch: 1;
                    wheel-vol := TouchArea {
                        vertical-stretch: 1;
                        width: 34px;
                        enabled: !root.bit-perfect && root.volume-enabled;
                        // Wheel over the slider = raw scroll offsets (dx, dy)
                        // in logical pixels, positive dy = louder. Clicks
                        // are counted by the input module, not here (ADR-8,
                        // §6.11, ТЗ-36); the step size is set by the core
                        // (ADR-14, НФ-2). Drag keeps working via the
                        // Slider's own TouchArea (scroll bubbles up here).
                        scroll-event(event) => {
                            if (event.delta-y != 0) {
                                root.volume-scroll(event.delta-x / 1px, event.delta-y / 1px);
                                return accept;
                            }
                            reject
                        }
                        HorizontalLayout {
                            alignment: center;
                            vertical-stretch: 1;
                            Slider {
                                vertical-stretch: 1;
                                width: 24px;
                                value <=> root.volume;
                                minimum: 0;
                                maximum: 1;
                                orientation: vertical;
                                enabled: !root.bit-perfect && root.volume-enabled;
                                changed(v) => { root.volume-changed(v); }
                            }
                        }
                    }
                }

                // Подсказка недоступной громкости (ТЗ-39, ADR-14, §2.13).
                // Tooltip стоит на обёртке колонки, которая сама не
                // отключается (wheel-vol и Slider отключаются отдельно), и
                // существует только при непустом тексте из Rust.
                if root.volume-block-text != "": Tooltip {
                    Rectangle {
                        width: 170px;
                        height: vol-block-tip-text.preferred-height + 10px;
                        background: Colors.bg-elevated;
                        border-color: Colors.border-default;
                        border-width: 1px;
                        border-radius: 4px;

                        vol-block-tip-text := Text {
                            text: root.volume-block-text;
                            color: Colors.text-secondary;
                            font-size: 11px;
                            wrap: word-wrap;
                            x: 6px;
                            y: 5px;
                            width: parent.width - 12px;
                        }
                    }
                }

                }
            VerticalLayout {
                vertical-stretch: 1;
                Rectangle { }
            }

            // Нижняя часть: кнопка mute такой же высоты, как панель с ползунком позиции
            HorizontalLayout {

                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;

                    // Mute доступен во всех режимах, в том числе при
                    // недоступной громкости (ТЗ-38, ADR-14).
                    IconButton {
                        icon: root.theme-palette == 0
                            ? (root.muted ? @image-url("icons/dark/muted.svg") : @image-url("icons/dark/volume.svg"))
                            : (root.muted ? @image-url("icons/light/muted.svg") : @image-url("icons/light/volume.svg"));
                        active: root.muted;
                        width: (root.cover-size * 1px - 10px) / 6;
                        height: 24px;
                        clicked => { root.toggle-mute(); }
                    }
                }
            }
        }

        VerticalLayout {
            width: root.col-gap * 1px / 2 + 1px;
        }
        }
    }

}
