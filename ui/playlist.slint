// Плейлист (Material Design): таблица треков на `StandardTableView`.
// Сортировка по заголовку, воспроизведение по клику на строку,
// подсветка текущего трека через `current-row`.

import { StandardTableView, Palette } from "std-widgets.slint";

export component Playlist inherits Rectangle {
    in property <[[StandardListViewItem]]> rows: [];
    in property <[TableColumn]> columns: [];
    in property <int> current-row: -1;

    callback sort-ascending(int);
    callback sort-descending(int);
    callback play-track(int);

    background: Palette.background;

    StandardTableView {
        rows: root.rows;
        columns: root.columns;
        current-row: root.current-row;

        sort-ascending(index) => {
            root.sort-ascending(index);
        }
        sort-descending(index) => {
            root.sort-descending(index);
        }
        row-pointer-event(row, event, _pos) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                root.play-track(row);
            }
        }
    }
}
