import { Colors } from "theme.slint";
import { StandardTableView } from "./tableview_fork.slint";

export component Playlist inherits Rectangle {
    in property <[[StandardListViewItem]]> rows: [
        [{ text: "No tracks" }]
    ];
    in property <[TableColumn]> cols: [{ title: "Title", width: 200px }];
    in property <int> current-row: -1;
    out property <length> view-width <=> view.visible-width;

    callback play-track(int);
    callback sort-ascending(int);
    callback sort-descending(int);

    public function do-scroll-to-row(index: int) {
        view.set-current-row(index);
    }

    background: Colors.bg-surface;
    border-radius: 4px;
    border-width: 1px;
    border-color: Colors.border-subtle;
    // Добавим небольшой внутренний отступ, если нужно (опционально)
    padding: 0px;

    // Layout, который заполняет весь родительский Rectangle
    VerticalLayout {
        spacing: 0;
        view := StandardTableView {
            visible: root.cols.length > 0;
            rows: root.rows;
            columns: root.cols;
            current-row: root.current-row;

            // Растягиваем таблицу на всё доступное место в Layout
            horizontal-stretch: 1;
            vertical-stretch: 1;
            // CRITICAL: without a generous max-width, the winit backend derives
            // the window's max-size from the root layout's max-size, and this
            // table is hard-fixed to sum(column.width) (each column is clamped
            // min=max=max=column.width in the material widget). That made the
            // window unable to grow beyond the playback columns and made it
            // SHRINK when a column was narrowed. A large max-width breaks the
            // window↔columns coupling: the window resizes freely and the
            // columns are reflown once, after the resize finishes.
            max-width: 10000px;

            sort-ascending(col) => {
                root.sort-ascending(col);
            }
            sort-descending(col) => {
                root.sort-descending(col);
            }
            row-pointer-event(row, event) => {
                if (event.kind == PointerEventKind.up) {
                    root.play-track(row);
                }
            }
        }

        if root.cols.length == 0 : HorizontalLayout {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            alignment: center;
            Text {
                text: "Нет активных колонок";
                color: Colors.text-dim;
                font-size: 16px;
            }
        }
    }
}