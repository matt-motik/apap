import { Colors } from "theme.slint";

export component StatusBar inherits Rectangle {
    in property <string> status-text: "Stopped";
    in property <string> track-info: "";
    in property <string> track-count: "0 tracks";

    background: Colors.bg-surface;
    border-width: 1px;
    border-color: Colors.border-subtle;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 16px;
        spacing: 8px;
        alignment: center;

        Text {
            text: root.status-text;
            color: Colors.text-secondary;
            font-size: 12px;
            overflow: elide;
            vertical-alignment: center;
        }

        Rectangle { } // stretch spacer

        Text {
            text: root.track-info;
            color: Colors.text-dim;
            font-size: 12px;
            overflow: elide;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
        Text {
            text: root.track-count;
            color: Colors.text-dim;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }
}
