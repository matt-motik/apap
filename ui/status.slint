import { Colors } from "theme.slint";

export component StatusBar inherits Rectangle {
    in property <string> status-text: "Stopped";
    in property <string> track-info: "";
    in property <string> track-count: "0 tracks";
    in property <bool> busy: false;
    // ТЗ §7.5: bit-perfect-режим активен — значок-индикатор в статус-баре.
    in property <bool> bp-active: false;
    // ТЗ §7.5: активен bit-perfect, но DSD выводится конверсией в PCM — для
    // DSD-потока bit-perfect не сохраняется.
    in property <bool> dsd-not-bp: false;

    background: Colors.bg-surface;
    border-width: 1px;
    border-color: Colors.border-subtle;

    // Thin accent strip: visible while a background task (folder scan /
    // file import) is running.
    Rectangle {
        y: 0;
        height: 3px;
        width: root.busy ? parent.width : 0px;
        background: Colors.accent;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 16px;
        spacing: 8px;
        //alignment: center;

        Text {
            text: root.status-text;
            color: Colors.text-secondary;
            font-size: 12px;
            overflow: elide;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
        } // stretch spacer

        Text {
            text: root.track-info;
            color: Colors.text-dim;
            font-size: 12px;
            overflow: elide;
            vertical-alignment: center;
            horizontal-alignment: right;
        }

        Text {
            text: root.track-count;
            color: Colors.text-dim;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
        // ТЗ §7.5: значок «Bit-perfect», когда режим активен.
        // Bit-perfect badge
        if root.bp-active && !root.dsd-not-bp: VerticalLayout {
            padding: 2px;
            Rectangle {
                border-width: 1px;
                border-color: Colors.accent;
                border-radius: 4px;
                VerticalLayout {
                    padding-left: 4px;
                    padding-right: 4px;
                    Text {
                        text: "Bit-perfect";
                        color: Colors.accent;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                }
            }
        }    
        // DSD→PCM warning badge
        if root.bp-active && root.dsd-not-bp:  VerticalLayout {
            padding: 2px;
            Rectangle {
                border-width: 1px;
                border-color: Colors.text-error;
                border-radius: 4px;
                VerticalLayout {
                    padding-left: 4px;
                    padding-right: 4px;
                    Text {
                        text: "Не bit-perfect (DSD→PCM)";
                        color: Colors.text-error;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
