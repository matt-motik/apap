import { Colors } from "theme.slint";
export { Colors }
import { FluentPalette } from "builtin:/fluent/styling.slint";
export { FluentPalette }
import { TopPanel, LockKind, MenuBarTrailing } from "top_panel.slint";
export { LockKind }
import { Playlist } from "playlist.slint";
import { StatusBar, BadgeKind } from "status.slint";
export { BadgeKind }
import {
    Settings,
    ColumnSetting,
    CoverSetting,
    ModeParamRow,
} from "settings.slint";
import { MessageWindow, MessageActionItem } from "message_window.slint";
import { Button, ScrollView } from "std-widgets.slint";

// Окно «Путь сигнала» (§3.6, ТЗ-71, ТЗ-81, ТЗ-84): строка этапа отчёта.
export struct PathStageRow {
    name: string,
    status: string,
    changes: string,
    causes: string,
    confidence: string,
    notes: string,
}

// Строка рекомендации окна «Путь сигнала» (ТЗ-81, ТЗ-84): action-id < 0 —
// кнопка не показывается, иначе значение передаётся в path-rec-action как есть.
export struct PathRecItem {
    text: string,
    action-label: string,
    action-id: int,
}

export component AppWindow inherits Window {
    // Заголовок окна «APAP — <трек>» / «APAP» (T1.0-B2, решение пользователя
    // 2026-10-23): по умолчанию без трека, обновляется из Rust при смене
    // текущего трека через music_player_rs::i18n::window_title() (src/app/mod.rs::sync_window_title).
    in property <string> window-title: "APAP";
    title: root.window-title;
    background: Colors.bg-window;
    max-width: 100000px;
    // Предпочтительная ширина = сохранённая ширина окна (ADR-22, §6.17,
    // SP1.0-B4): Slint при создании окна выставляет ширину элемента окна в
    // предпочтительную; ограничений на ресайз она не накладывает.
    in property <length> initial-width: 0px;
    preferred-width: initial-width;

    // Нативное меню (MenuBar) — первое меню в окне. Содержит: Файл (add,
    // плейлист, выход), Визуализация (checkable, §3.2), Настройки/О программе.
    // checked: `root.settings-viz-mode == N` (synced via settings-viz-mode).
    // enabled: !root.window-blocked на каждом пункте — главное окно недоступно,
    // пока взведена причина блокировки UiGate (ADR-12, ТЗ-23): диалог настроек,
    // окно сообщения или выбор файла.
    MenuBar {
        Menu {
            title: "Файл";
            MenuItem {
                title: "Добавить файлы";
                enabled: !root.window-blocked;
                activated => { root.add-files(); }
            }

            MenuItem {
                title: "Добавить папку";
                enabled: !root.window-blocked;
                activated => { root.add-folder(); }
            }

            MenuSeparator { }

            // Действия с плейлистом — в меню, не в диалоге настроек (ТЗ-34, ОВ-10).
            MenuItem {
                title: "Удалить выделенный трек";
                enabled: !root.window-blocked;
                activated => { root.menu-remove-selected(playlist_view_width.selected-row); }
            }

            MenuItem {
                title: "Очистить плейлист";
                enabled: !root.window-blocked;
                activated => { root.menu-clear-playlist(); }
            }

            MenuSeparator { }

            MenuItem {
                title: "Сохранить плейлист";
                enabled: !root.window-blocked;
                activated => { root.save-playlist(); }
            }

            MenuItem {
                title: "Загрузить плейлист";
                enabled: !root.window-blocked;
                activated => { root.load-playlist(); }
            }

            MenuSeparator { }

            // Выход из программы (§6.10, ТЗ-14): путь выхода напрямую, без
            // сворачивания в трей по настройке закрытия окна (SP1.0-B17).
            MenuItem {
                title: "Выход";
                enabled: !root.window-blocked;
                activated => { root.menu-quit(); }
            }
        }

        Menu {
            title: "Визуализация";
            MenuItem {
                title: "Отключена";
                checked: root.settings-viz-mode == 0;
                enabled: !root.window-blocked;
                activated => { root.menu-select-viz(0); }
            }

            MenuItem {
                title: "Осциллограмма";
                checked: root.settings-viz-mode == 1;
                enabled: !root.window-blocked;
                activated => { root.menu-select-viz(1); }
            }

            MenuItem {
                title: "Спектрограмма";
                checked: root.settings-viz-mode == 2;
                enabled: !root.window-blocked;
                activated => { root.menu-select-viz(2); }
            }

            MenuItem {
                title: "Анализатор спектра";
                checked: root.settings-viz-mode == 3;
                enabled: !root.window-blocked;
                activated => { root.menu-select-viz(3); }
            }
        }

        Menu {
            title: "Настройки";
            MenuItem {
                title: "Параметры";
                enabled: !root.window-blocked;
                activated => { root.open-settings(); }
            }

            MenuSeparator { }

            MenuItem {
                title: "О программе";
                enabled: !root.window-blocked;
                activated => { root.show-about(); }
            }
        }
    }

    in property <float> cover-size: 200;
    in property <float> col-info-w: 240;
    in property <float> col-gap: 12;
    in property <image> cover-art;

    in property <bool> playing: false;
    in property <bool> repeat: false;
    in property <bool> repeat-one: false;
    in property <bool> shuffle: false;
    in property <bool> muted: false;
    // ADR-14, ТЗ-35, ТЗ-37: значение приходит только из Rust (`set_volume` после
    // каждой команды); до ползунка в TopPanel проброшено двусторонне.
    in-out property <float> volume: 0.8;
    // ТЗ-41, ADR-23, §6.18: громкость задана активным режимом (не bit-perfect) —
    // программный слайдер блокируется, мьют остаётся доступен.
    in property <bool> volume-enabled: true;
    // ТЗ-39, ADR-14, §2.13: текст подсказки недоступной громкости; пустая
    // строка — громкость доступна, подсказки нет.
    in property <string> volume-block-text: "";
    // Переключатель режимов (ТЗ-18, ТЗ-109, ТЗ-110): индекс активного
    // режима (0 Совместимый, 1 Оптимальный, 2 Строгий), доступность и
    // причина недоступности по индексу режима (пустая строка — доступен).
    in property <int> active-mode: 0;
    in property <[bool]> mode-available: [true, true, true];
    in property <[string]> mode-unavailable-reason: ["", "", ""];
    callback select-mode(int);
    in property <bool> bit-perfect: false;
    // ADR-06, §6.19, ТЗ-44, ТЗ-46, ТЗ-50, ТЗ-118, ТЗ-144: кнопка-значок
    // замка устройства (LockButton, ui/top_panel.slint) — вид по lock-kind,
    // текст/подсказка из Rust (LockView, src/app/lock_view.rs). Клик сам
    // выбирает lock-close/lock-open по kind.
    in property <LockKind> lock-kind: LockKind.not-applicable;
    in property <string> lock-text: "";
    in property <string> lock-hint: "";
    callback lock-close();
    callback lock-open();
    // AM1.0-B30 шаг 3: ярлык бейджа фактически открытого устройства
    // (MenuBarTrailing, ui/top_panel.slint) — тот же текст, что в
    // DeviceInfoView.now_line (src/app/device_info_view.rs), без приставки;
    // "" — ничего не открыто, бейдж скрыт целиком. Выставляет Rust
    // (`sync_device_badge`, src/app/ui_manager.rs) только при изменении.
    in property <string> device-label: "";
    // AM1.0-B14 шаг 8: true (Linux/Windows) — строка меню встроена в окно,
    // кнопка замка (MenuBarTrailing) накладывается оверлеем на её правый
    // край ниже; false (macOS, системный NSMenu) — та же группа встаёт у
    // правого края верхней панели (TopPanel, ui/top_panel.slint). Выставляет
    // Rust при создании окна (`cfg!(target_os = "macos")`, src/app/mod.rs).
    in property <bool> menu-bar-in-window: true;
    // Высота строки встроенного MenuBar — Fluent-стиль фиксирует её
    // (widgets/fluent/menu.slint: `MenuBar inherits MenuBarBase { min-layout-height: 40px; }`);
    // Slint не даёт runtime-доступа к фактической высоте MenuBar, поэтому
    // константа держится в синхроне с виджетом style руками (проект
    // закреплён на Fluent, ветка `menu-bar-in-window: false` эту константу
    // не использует).
    private property <length> menu-bar-height: 40px;
    in property <float> seek-fraction: 0.0;
    out property <bool> seekbar-dragging: main-top.seekbar-dragging;
    in property <string> pos: "0:00";
    in property <string> dur: "0:00";

    in property <string> status-text: @tr("Остановлено");
    in property <string> track-info: "";
    in property <string> track-count: @tr("0 треков");
    in property <bool> busy: false;

    // ADR-06, ТЗ-52, ТЗ-56: модель бейджа тракта (BadgeState).
    in property <BadgeKind> status-badge-kind: BadgeKind.none;
    in property <string> status-badge-text: "";
    // ТЗ-61, ТЗ-62, ТЗ-106: индикатор автотеста bit-perfect (TestBadge / TestAvailability).
    in property <bool> status-test-visible: false;
    in property <bool> status-test-enabled: false;
    in property <string> status-test-text: "";
    in property <string> status-test-hint: "";

    in property <string> info-artist: "—";
    in property <bool> info-has-track: false;
    in property <string> info-track: "—";
    in property <string> info-title: "—";
    in property <string> info-duration: "—";
    in property <string> info-year: "—";
    in property <string> info-album: "—";
    in property <string> info-disc: "—";
    in property <string> info-genre: "—";
    in property <string> info-format: "—";
    in property <string> info-bitrate: "—";
    in property <string> info-bit-depth: "—";
    in property <string> info-sample-rate: "—";
    in property <string> info-channels: "—";

    in property <[string]> info-labels: [
        @tr("Исполнитель"),
        @tr("Трек"),
        @tr("Название"),
        @tr("Длительность"),
        @tr("Год"),
        @tr("Альбом"),
        @tr("Диск"),
        @tr("Жанр"),
        @tr("Формат"),
        @tr("Битрейт"),
        @tr("Разрядность"),
        @tr("Частота дискретизации"),
        @tr("Каналы")
    ];

    in property <int> viz-mode: 0;
    in property <float> build-progress: 0.0;
    in property <image> osc-image: @image-url("");
    in property <bool> osc-ready: false;
    in property <string> disabled-text: "";
    in property <[float]> spectrum-l: [];
    in property <[float]> spectrum-r: [];
    in property <int> viz-channels: 2;
    in property <float> bar-gap: 2;
    in property <float> bar-radius: 2;
    in property <bool> gradient: true;

    in property <[[StandardListViewItem]]> playlist-rows: [[{ text: @tr("Нет треков") }]];
    in-out property <[TableColumn]> playlist-cols: [{ title: @tr("Название"), width: 200px }];
    in property <int> current-row: -1;
    out property <length> playlist-view-width: playlist_view_width.view-width;

    in property <bool> settings-open: false;
    // ADR-12, ТЗ-23: истина, пока UiGate держит хотя бы одну причину блокировки
    // главного окна (Dialog/Message/FilePicker). Гасит оверлей ниже, меню и
    // горячие клавиши корневого FocusScope.
    in property <bool> window-blocked: false;
    // ADR-13, §6.15, ТЗ-52, ТЗ-46, ТЗ-144: окно сообщения — проброс в
    // MessageWindow; `msg-actions` — переменный набор кнопок (AM1.0-B14 шаг 4,
    // см. `MessageActionItem`), `msg-action` — единый callback на клик любой
    // из них (id — её `action-id`).
    in property <bool> msg-shown: false;
    in property <int> msg-level: 2;
    in property <string> msg-title: "";
    in property <string> msg-body: "";
    in property <[MessageActionItem]> msg-actions: [];
    callback msg-action(int);
    in property <bool> bp-report-open: false;
    // Окно «Путь сигнала» (§3.6, ТЗ-71, ТЗ-81, ТЗ-84).
    in property <string> path-title: "";
    in property <[PathStageRow]> path-stages: [];
    in property <[PathRecItem]> path-recs-player: [];
    in property <[PathRecItem]> path-recs-os: [];
    in property <[PathRecItem]> path-recs-hardware: [];
    in property <string> path-footer: "";
    in property <string> path-copy-text: "";
    // T1.0 §7: палитра стандартных виджетов/иконок (0=dark, 1=light).
    in property <int> theme-palette: 0;
    // T1.0 §5: список тем и состояние UI выбора темы в диалоге.
    in property <[string]> theme-list-model: [""];
    in-out property <string> theme-current: "";
    // Индекс theme-current в theme-list-model для подсветки попапа ComboBox (§5.1, T1.0-B4).
    in-out property <int> theme-current-index: 0;
    in property <string> theme-name: "";
    in property <string> theme-description: "";
    // Доступность «Сохранить» и подсказка с причиной недоступности (ТЗ-27, §6.9).
    in property <bool> settings-save-enabled: true;
    in property <string> settings-save-tooltip: "";
    in property <bool> settings-minimize: false;
    in property <int> settings-save-interval-idx: 1;
    in property <string> settings-save-notice: "";
    in property <[string]> settings-devices: [];
    in-out property <int> settings-device-idx: -1;
    // AM1.0-B30 (§8 С11): вид возможностей устройства, редактируемого в
    // диалоге настроек (DeviceInfoView) — заменяет always-empty codec-info
    // и устаревающую метку active-device прежнего блока.
    in property <string> settings-device-now-line: "";
    in property <string> settings-device-rates-line: "";
    in property <string> settings-device-bits-line: "";
    in property <string> settings-device-dsd-line: "";
    in property <string> settings-device-mixer-line: "";
    in property <string> settings-active-error: "";
    // §6.18, §6.27, ТЗ-41, ТЗ-94: панель построчных настроек режима.
    in property <int> settings-mode-edit-mode: 0;
    in property <[ModeParamRow]> settings-mode-rows: [];
    in property <string> settings-mode-validation: "";
    in property <[ColumnSetting]> settings-cols: [];
    in-out property <int> settings-selected-col: -1;
    // ADR-24, ТЗ-144: активная вкладка диалога настроек (замок открывает
    // диалог сразу на «Audio», шаг 71).
    in-out property <int> settings-tab: 0;
    in property <[CoverSetting]> settings-covers: [];
    in property <string> settings-cover-names: "";
    in property <bool> settings-cover-online: true;

    callback play-pause();
    callback stop();
    callback prev-track();
    callback next-track();
    callback toggle-repeat();
    callback toggle-shuffle();
    callback seek(float);
    callback seek-commit(float);
    callback volume-changed(float);
    // сырой scroll-event над ползунком: (dx, dy) в логических пикселях; щелчки
    // считает модуль ввода, положительное dy — громче (ADR-8, §6.11, ТЗ-36)
    callback volume-scroll(float, float);
    callback toggle-mute();
    callback play-track(int);
    callback scroll-to-row(int);
    scroll-to-row(idx) => { playlist_view_width.do-scroll-to-row(idx); }
    callback sort-ascending(int);
    callback sort-descending(int);
    callback open-settings();
    callback add-files();
    callback add-folder();
    callback save-playlist();
    callback load-playlist();
    callback settings-close();
    callback settings-theme-selected(string);
    callback settings-cover-size(float);
    callback settings-col-info-w(float);
    callback settings-col-gap(float);
    callback settings-toggle-minimize(bool);
    callback settings-save-interval(int);
    callback settings-device(string);
    callback settings-refresh-devices();
    // §6.18, §6.27, ТЗ-41, ТЗ-94: панель построчных настроек режима.
    callback settings-mode-edit-mode-selected(int);
    callback settings-mode-row-index-changed(int, int);
    callback settings-mode-row-toggled(int, bool);
    callback settings-mode-row-slider-changed(int, float);
    callback bp-clicked();
    callback bp-report-close();
    callback bp-report-open-settings();
    // Окно «Путь сигнала» (ТЗ-81): клик по кнопке рекомендации, int — её action-id.
    callback path-rec-action(int);
    callback settings-toggle-col(int);
    callback settings-reset-cols();
    callback settings-move-col-up(int);
    callback settings-move-col-down(int);
    callback menu-clear-playlist();
    callback menu-remove-selected(int);
    // Пункт «Выход» меню «Файл» (§6.10, ТЗ-14, SP1.0-B17).
    callback menu-quit();
    callback settings-save();
    // §10.5: кнопки очистки кэша
    callback settings-clear-viz-cache();
    callback settings-clear-cover-cache();
    callback settings-clear-all-cache();
    callback settings-cover-move-up(int);
    callback settings-cover-move-down(int);
    callback settings-cover-names-edited(string);
    callback settings-toggle-cover-online(bool);
    callback show-about();

    in property <int> settings-viz-mode: 0;
    in property <bool> settings-viz-skip-dsd: true;
    in property <string> settings-viz-error: "";
    in property <bool> settings-viz-freq-min-invalid: false;
    in property <bool> settings-viz-freq-max-invalid: false;
    in property <bool> settings-viz-bands-invalid: false;
    in-out property <string> settings-viz-freq-min-text: "20";
    in-out property <string> settings-viz-freq-max-text: "22000";
    in-out property <string> settings-viz-bands-text: "32";
    in property <int> settings-viz-osc-channels: 1;
    in property <float> settings-viz-osc-sensitivity: 1.0;
    in property <float> settings-viz-osc-line-width: 1.2;
    in property <bool> settings-viz-osc-center-line: false;
    in property <int> settings-viz-osc-max-columns: 2000;
    in property <bool> settings-viz-osc-cache-mem: true;
    in property <bool> settings-viz-osc-cache-disk: true;
    in property <int> settings-viz-spec-channels: 1;
    in property <float> settings-viz-spec-sensitivity: 1.0;
    in property <int> settings-viz-spec-fft: 2;
    in property <int> settings-viz-spec-window: 0;
    in property <int> settings-viz-spec-scale: 1;
    in property <float> settings-viz-spec-gain: 20;
    in property <float> settings-viz-spec-range: 80;
    in property <float> settings-viz-spec-boost: 6;
    in property <int> settings-viz-spec-palette: 1;
    in property <int> settings-viz-spec-max-frames: 4000;
    in property <bool> settings-viz-spec-dsd-comp: true;
    in property <bool> settings-viz-spec-cache-mem: true;
    in property <bool> settings-viz-spec-cache-disk: true;
    in property <int> settings-viz-sp-channels: 1;
    in property <float> settings-viz-sp-sensitivity: 1.0;
    in property <int> settings-viz-sp-freq-scale: 1;
    in property <int> settings-viz-sp-level-scale: 1;
    in property <float> settings-viz-sp-smoothing: 0.7;
    in property <bool> settings-viz-sp-peak-hold: false;
    in property <int> settings-viz-sp-peak-decay: 400;
    in property <int> settings-viz-sp-bar-gap: 2;
    in property <int> settings-viz-sp-bar-radius: 2;
    in property <bool> settings-viz-sp-gradient: true;
    in property <bool> settings-viz-sp-dsd-comp: true;
    // §10.5: статистика кэша визуализации (RAM / Disk, форматируется в Rust).
    in property <string> settings-cache-ram-size: "";
    in property <string> settings-cache-viz-size: "";
    in property <string> settings-cache-cover-size: "";

    callback cycle-viz();
    callback menu-select-viz(int);
    callback settings-set-viz-mode(int);
    callback settings-set-viz-skip-dsd(bool);
    callback settings-set-viz-reset-type();
    callback settings-set-viz-osc-channels(int);
    callback settings-set-viz-osc-sensitivity(float);
    callback settings-set-viz-osc-line-width(float);
    callback settings-set-viz-osc-center-line(bool);
    callback settings-set-viz-osc-max-columns(int);
    callback settings-set-viz-osc-cache-mem(bool);
    callback settings-set-viz-osc-cache-disk(bool);
    callback settings-set-viz-spec-channels(int);
    callback settings-set-viz-spec-sensitivity(float);
    callback settings-set-viz-spec-fft(int);
    callback settings-set-viz-spec-window(int);
    callback settings-set-viz-spec-scale(int);
    callback settings-set-viz-spec-freq-min(string);
    callback settings-set-viz-spec-freq-max(string);
    callback settings-set-viz-spec-gain(float);
    callback settings-set-viz-spec-range(float);
    callback settings-set-viz-spec-boost(float);
    callback settings-set-viz-spec-palette(int);
    callback settings-set-viz-spec-max-frames(int);
    callback settings-set-viz-spec-dsd-comp(bool);
    callback settings-set-viz-spec-cache-mem(bool);
    callback settings-set-viz-spec-cache-disk(bool);
    callback settings-set-viz-sp-channels(int);
    callback settings-set-viz-sp-sensitivity(float);
    callback settings-set-viz-sp-bands(string);
    callback settings-set-viz-sp-freq-scale(int);
    callback settings-set-viz-sp-level-scale(int);
    callback settings-set-viz-sp-smoothing(float);
    callback settings-set-viz-sp-peak-hold(bool);
    callback settings-set-viz-sp-peak-decay(int);
    callback settings-set-viz-sp-bar-gap(int);
    callback settings-set-viz-sp-bar-radius(int);
    callback settings-set-viz-sp-gradient(bool);
    callback settings-set-viz-sp-dsd-comp(bool);

    // Hotkey V — циклическое переключение типа визуализации (ТЗ §3.2).
    // Корневой FocusScope оборачивает весь контент: внутренние FocusScope-ы
    // отвергают незнакомые клавиши, событие всплывает сюда. Disabled while
    // the window is blocked (ADR-12, ТЗ-23) so typing in LineEdits/the message
    // window does not cycle the visualizer.
    root-focus := FocusScope {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        enabled: !root.window-blocked;
        KeyBinding {
            keys: @keys(V);
            enabled: !root.window-blocked;
            activated => { root.cycle-viz(); }
        }

        VerticalLayout {
            spacing: 0;

            main-top := TopPanel {
                horizontal-stretch: 1;
                max-height: root.cover-size * 1px + 50px;
                theme-palette: root.theme-palette;
                cover-size: root.cover-size;
                col-info-w: root.col-info-w;
                col-gap: root.col-gap;
                cover-art: root.cover-art;
                playing: root.playing;
                repeat: root.repeat;
                repeat-one: root.repeat-one;
                shuffle: root.shuffle;
                muted: root.muted;
                volume <=> root.volume;
                volume-enabled: root.volume-enabled;
                volume-block-text: root.volume-block-text;
                active-mode: root.active-mode;
                mode-available: root.mode-available;
                mode-unavailable-reason: root.mode-unavailable-reason;
                bit-perfect: root.bit-perfect;
                lock-kind: root.lock-kind;
                lock-text: root.lock-text;
                lock-hint: root.lock-hint;
                device-label: root.device-label;
                menu-bar-in-window: root.menu-bar-in-window;
                seek-fraction: root.seek-fraction;
                pos: root.pos;
                dur: root.dur;
                info-artist: root.info-artist;
                info-has-track: root.info-has-track;
                info-track: root.info-track;
                info-title: root.info-title;
                info-duration: root.info-duration;
                info-year: root.info-year;
                info-album: root.info-album;
                info-disc: root.info-disc;
                info-genre: root.info-genre;
                info-format: root.info-format;
                info-bitrate: root.info-bitrate;
                info-bit-depth: root.info-bit-depth;
                info-sample-rate: root.info-sample-rate;
                info-channels: root.info-channels;
                info-labels: root.info-labels;
                viz-mode: root.viz-mode;
                build-progress: root.build-progress;
                osc-image: root.osc-image;
                osc-ready: root.osc-ready;
                disabled-text: root.disabled-text;
                spectrum-l: root.spectrum-l;
                spectrum-r: root.spectrum-r;
                viz-channels: root.viz-channels;
                bar-gap: root.bar-gap;
                bar-radius: root.bar-radius;
                gradient: root.gradient;
                play-pause => { root.play-pause(); }
                stop => { root.stop(); }
                prev-track => { root.prev-track(); }
                next-track => { root.next-track(); }
                toggle-repeat => { root.toggle-repeat(); }
                toggle-shuffle => { root.toggle-shuffle(); }
                seek(v) => { root.seek(v); }
                seek-commit(v) => { root.seek-commit(v); }
                volume-changed(v) => { root.volume-changed(v); }
                volume-scroll(dx, dy) => { root.volume-scroll(dx, dy); }
                toggle-mute => { root.toggle-mute(); }
                select-mode(i) => { root.select-mode(i); }
                lock-close => { root.lock-close(); }
                lock-open => { root.lock-open(); }
            }

            HorizontalLayout {
                Rectangle {
                    height: 6px;
                }
            }

            playlist_view_width := Playlist {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                rows: root.playlist-rows;
                cols: root.playlist-cols;
                current-row: root.current-row;
                play-track(i) => { root.play-track(i); }
                sort-ascending(c) => { root.sort-ascending(c); }
                sort-descending(c) => { root.sort-descending(c); }
            }

            StatusBar {
                status-text: root.status-text;
                track-info: root.track-info;
                track-count: root.track-count;
                busy: root.busy;
                badge-kind: root.status-badge-kind;
                badge-text: root.status-badge-text;
                test-visible: root.status-test-visible;
                test-enabled: root.status-test-enabled;
                test-text: root.status-test-text;
                test-hint: root.status-test-hint;
                bp-clicked => { root.bp-clicked(); }
            }
        }
    }

    // AM1.0-B14 шаг 8: группа «режим ▾ · устройство · замок» (сейчас —
    // только замок, MenuBarTrailing) оверлеем над правым краем встроенного
    // MenuBar (Linux/Windows, `menu-bar-in-window`). Slint лишает
    // встроенный MenuBar и весь остальной контент окна общего родителя
    // (компилятор превращает `Window { MenuBar{...} остальное }` в
    // `VerticalLayout { MenuBarImpl; Empty{ остальное } }` — passes/
    // lower_menus.rs в i-slint-compiler, `root.height` после этого уже
    // означает высоту `Empty`, не всего окна); этот элемент — потомок той
    // самой `Empty`, поэтому отрицательный `y` поднимает его из тела окна
    // в область строки меню, рисуемой раньше (нет clip — не обрезается).
    // Скрыт на macOS (`menu-bar-in-window: false`) — там та же группа стоит
    // в TopPanel (ui/top_panel.slint), у правого края верхней панели.
    // Реальный HorizontalLayout (не Rectangle) — ширина/высота этого
    // контейнера заданы явно (100% / menu-bar-height), поэтому компилятор
    // не пытается подставить свой `width: 100%`-дефолт для layout-элемента
    // без явной геометрии (который иначе зациклился бы на размере самого
    // MenuBarTrailing); `alignment: end` и `padding-right` прижимают
    // MenuBarTrailing к правому краю, вертикальное центрирование
    // LockButton (фиксированная высота 24px) в полосе menu-bar-height даёт
    // сам layout-движок — без ручной арифметики.
    if root.menu-bar-in-window: HorizontalLayout {
        x: 0px;
        y: -root.menu-bar-height;
        width: 100%;
        height: root.menu-bar-height;
        padding-right: 12px;
        alignment: end;

        MenuBarTrailing {
            lock-kind: root.lock-kind;
            lock-text: root.lock-text;
            lock-hint: root.lock-hint;
            theme-palette: root.theme-palette;
            device-label: root.device-label;
            lock-close => { root.lock-close(); }
            lock-open => { root.lock-open(); }
        }
    }

    // Оверлей блокировки главного окна (ADR-12, ТЗ-23): перехватывает
    // указатель, колёсико и клавиатуру, пока UiGate держит причину блокировки.
    // Лежит НИЖЕ диалога настроек и окна сообщения (оба объявлены дальше по
    // дереву), поэтому сам диалог/окно остаются кликабельными и получают
    // фокус, даже когда именно они — причина блокировки.
    if root.window-blocked: Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { }
            scroll-event(event) => {
                EventResult.accept
            }
        }

        FocusScope {
            width: 100%;
            height: 100%;
            init => { self.focus(); }
            key-pressed(event) => {
                return accept;
            }
            key-released(event) => {
                return accept;
            }
        }
    }

    // Окно информации о тракте немодальное (AM1.0-B3): клики перехватываются
    // только внутри самой панели, снаружи доходят до главного окна.
    Rectangle {
        visible: root.bp-report-open;
        width: 560px;
        height: 480px;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: Colors.bg-surface;
        border-radius: 8px;
        border-width: 1px;
        border-color: Colors.border-default;

        // Клик/прокрутка внутри панели не проваливаются в плейлист под ней.
        TouchArea {
            width: 100%;
            height: 100%;
            scroll-event(event) => {
                EventResult.accept
            }
        }

        // Скрытое read-only поле для «Копировать отчёт» (ТЗ-84): нулевой
        // размер, вне VerticalLayout ниже, чтобы не занимать место в разметке.
        // select-all()/copy() у TextInput работают независимо от visible/width.
        path_copy_input := TextInput {
            x: 0px;
            y: 0px;
            width: 0px;
            height: 0px;
            text: root.path-copy-text;
            read-only: true;
        }

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            Text {
                text: root.path-title;
                color: Colors.text-primary;
                font-size: 16px;
                wrap: word-wrap;
            }

            Rectangle {
                vertical-stretch: 1;
                background: Colors.bg-window;
                border-radius: 4px;
                ScrollView {
                    VerticalLayout {
                        padding: 8px;
                        spacing: 8px;

                        for stage[i] in root.path-stages: Rectangle {
                            background: Colors.surface-hover;
                            border-radius: 4px;
                            VerticalLayout {
                                padding: 8px;
                                spacing: 2px;
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: stage.name;
                                        color: Colors.text-primary;
                                        font-size: 13px;
                                    }

                                    Text {
                                        text: stage.status;
                                        color: Colors.text-secondary;
                                        font-size: 13px;
                                    }
                                }

                                if stage.changes != "": Text {
                                    text: "Изменения: " + stage.changes;
                                    color: Colors.text-secondary;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }

                                if stage.causes != "": Text {
                                    text: "Причины: " + stage.causes;
                                    color: Colors.text-secondary;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }

                                if stage.confidence != "": Text {
                                    text: "Достоверность: " + stage.confidence;
                                    color: Colors.text-tertiary;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }

                                if stage.notes != "": Text {
                                    text: stage.notes;
                                    color: Colors.text-tertiary;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        if root.path-recs-player.length > 0: VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "Настройки плеера";
                                color: Colors.text-tertiary;
                                font-size: 12px;
                            }

                            for item in root.path-recs-player: HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: item.text;
                                    color: Colors.text-primary;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                }

                                if item.action-id >= 0: Button {
                                    text: item.action-label;
                                    preferred-height: 22px;
                                    clicked => { root.path-rec-action(item.action-id); }
                                }
                            }
                        }

                        if root.path-recs-os.length > 0: VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "Система";
                                color: Colors.text-tertiary;
                                font-size: 12px;
                            }

                            for item in root.path-recs-os: HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: item.text;
                                    color: Colors.text-primary;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                }

                                if item.action-id >= 0: Button {
                                    text: item.action-label;
                                    preferred-height: 22px;
                                    clicked => { root.path-rec-action(item.action-id); }
                                }
                            }
                        }

                        if root.path-recs-hardware.length > 0: VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "Оборудование";
                                color: Colors.text-tertiary;
                                font-size: 12px;
                            }

                            for item in root.path-recs-hardware: HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: item.text;
                                    color: Colors.text-primary;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                }

                                if item.action-id >= 0: Button {
                                    text: item.action-label;
                                    preferred-height: 22px;
                                    clicked => { root.path-rec-action(item.action-id); }
                                }
                            }
                        }
                    }
                }
            }

            Text {
                text: root.path-footer;
                color: Colors.text-tertiary;
                font-size: 11px;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Rectangle {
                    horizontal-stretch: 1;
                }

                Button {
                    text: "Копировать отчёт";
                    preferred-height: 28px;
                    clicked => {
                        path_copy_input.select-all();
                        path_copy_input.copy();
                        path_copy_input.clear-selection();
                    }
                }

                Button {
                    text: "Настройки аудио";
                    preferred-height: 28px;
                    clicked => { root.bp-report-open-settings(); }
                }

                Button {
                    text: "Закрыть";
                    preferred-height: 28px;
                    clicked => { root.bp-report-close(); }
                }
            }
        }
    }

    Settings {
        width: 100%;
        height: 100%;
        open: root.settings-open;
        cover-size: root.cover-size;
        col-info-w: root.col-info-w;
        col-gap: root.col-gap;
        minimize-to-tray: root.settings-minimize;
        save-interval-idx: root.settings-save-interval-idx;
        save-notice: root.settings-save-notice;
        save-enabled: root.settings-save-enabled;
        save-tooltip: root.settings-save-tooltip;
        audio-devices: root.settings-devices;
        audio-device-idx <=> root.settings-device-idx;
        device-now-line: root.settings-device-now-line;
        device-rates-line: root.settings-device-rates-line;
        device-bits-line: root.settings-device-bits-line;
        device-dsd-line: root.settings-device-dsd-line;
        device-mixer-line: root.settings-device-mixer-line;
        active-error: root.settings-active-error;
        mode-edit-mode: root.settings-mode-edit-mode;
        mode-rows: root.settings-mode-rows;
        mode-validation: root.settings-mode-validation;
        columns-cfg: root.settings-cols;
        selected-col <=> root.settings-selected-col;
        settings-tab <=> root.settings-tab;
        covers: root.settings-covers;
        cover-names: root.settings-cover-names;
        cover-online: root.settings-cover-online;
        theme-list-model: root.theme-list-model;
        theme-current <=> root.theme-current;
        theme-current-index <=> root.theme-current-index;
        theme-name: root.theme-name;
        theme-description: root.theme-description;
        close => { root.settings-close(); }
        settings-theme-selected(s) => { root.settings-theme-selected(s); }
        set-cover-size(v) => { root.settings-cover-size(v); }
        set-col-info-w(v) => { root.settings-col-info-w(v); }
        set-col-gap(v) => { root.settings-col-gap(v); }
        set-minimize-to-tray(b) => { root.settings-toggle-minimize(b); }
        set-save-interval(i) => { root.settings-save-interval(i); }
        set-audio-device(s) => { root.settings-device(s); }
        refresh-devices => { root.settings-refresh-devices(); }
        mode-edit-mode-selected(i) => { root.settings-mode-edit-mode-selected(i); }
        mode-row-index-changed(param, i) => { root.settings-mode-row-index-changed(param, i); }
        mode-row-toggled(param, b) => { root.settings-mode-row-toggled(param, b); }
        mode-row-slider-changed(param, v) => { root.settings-mode-row-slider-changed(param, v); }
        toggle-column(i) => { root.settings-toggle-col(i); }
        reset-columns => { root.settings-reset-cols(); }
        move-col-up(i) => { root.settings-move-col-up(i); }
        move-col-down(i) => { root.settings-move-col-down(i); }
        save-settings => { root.settings-save(); }
        cover-move-up(i) => { root.settings-cover-move-up(i); }
        cover-move-down(i) => { root.settings-cover-move-down(i); }
        cover-names-edited(t) => { root.settings-cover-names-edited(t); }
        toggle-cover-online(b) => { root.settings-toggle-cover-online(b); }
        viz-mode: root.settings-viz-mode;
        viz-skip-dsd: root.settings-viz-skip-dsd;
        viz-error: root.settings-viz-error;
        viz-freq-min-invalid: root.settings-viz-freq-min-invalid;
        viz-freq-max-invalid: root.settings-viz-freq-max-invalid;
        viz-bands-invalid: root.settings-viz-bands-invalid;
        viz-freq-min-text <=> root.settings-viz-freq-min-text;
        viz-freq-max-text <=> root.settings-viz-freq-max-text;
        viz-bands-text <=> root.settings-viz-bands-text;
        viz-osc-channels: root.settings-viz-osc-channels;
        viz-osc-sensitivity: root.settings-viz-osc-sensitivity;
        viz-osc-line-width: root.settings-viz-osc-line-width;
        viz-osc-center-line: root.settings-viz-osc-center-line;
        viz-osc-max-columns: root.settings-viz-osc-max-columns;
        viz-osc-cache-mem: root.settings-viz-osc-cache-mem;
        viz-osc-cache-disk: root.settings-viz-osc-cache-disk;
        viz-spec-channels: root.settings-viz-spec-channels;
        viz-spec-sensitivity: root.settings-viz-spec-sensitivity;
        viz-spec-fft: root.settings-viz-spec-fft;
        viz-spec-window: root.settings-viz-spec-window;
        viz-spec-scale: root.settings-viz-spec-scale;
        viz-spec-gain: root.settings-viz-spec-gain;
        viz-spec-range: root.settings-viz-spec-range;
        viz-spec-boost: root.settings-viz-spec-boost;
        viz-spec-palette: root.settings-viz-spec-palette;
        viz-spec-max-frames: root.settings-viz-spec-max-frames;
        viz-spec-dsd-comp: root.settings-viz-spec-dsd-comp;
        viz-spec-cache-mem: root.settings-viz-spec-cache-mem;
        viz-spec-cache-disk: root.settings-viz-spec-cache-disk;
        viz-sp-channels: root.settings-viz-sp-channels;
        viz-sp-sensitivity: root.settings-viz-sp-sensitivity;
        viz-sp-freq-scale: root.settings-viz-sp-freq-scale;
        viz-sp-level-scale: root.settings-viz-sp-level-scale;
        viz-sp-smoothing: root.settings-viz-sp-smoothing;
        viz-sp-peak-hold: root.settings-viz-sp-peak-hold;
        viz-sp-peak-decay: root.settings-viz-sp-peak-decay;
        viz-sp-bar-gap: root.settings-viz-sp-bar-gap;
        viz-sp-bar-radius: root.settings-viz-sp-bar-radius;
        viz-sp-gradient: root.settings-viz-sp-gradient;
        viz-sp-dsd-comp: root.settings-viz-sp-dsd-comp;
        cache-ram-size: root.settings-cache-ram-size;
        cache-viz-size: root.settings-cache-viz-size;
        cache-cover-size: root.settings-cache-cover-size;
        set-viz-mode(i) => { root.settings-set-viz-mode(i); }
        set-viz-skip-dsd(b) => { root.settings-set-viz-skip-dsd(b); }
        reset-viz-type => { root.settings-set-viz-reset-type(); }
        set-viz-osc-channels(i) => { root.settings-set-viz-osc-channels(i); }
        set-viz-osc-sensitivity(v) => { root.settings-set-viz-osc-sensitivity(v); }
        set-viz-osc-line-width(v) => { root.settings-set-viz-osc-line-width(v); }
        set-viz-osc-center-line(b) => { root.settings-set-viz-osc-center-line(b); }
        set-viz-osc-max-columns(i) => { root.settings-set-viz-osc-max-columns(i); }
        set-viz-osc-cache-mem(b) => { root.settings-set-viz-osc-cache-mem(b); }
        set-viz-osc-cache-disk(b) => { root.settings-set-viz-osc-cache-disk(b); }
        set-viz-spec-channels(i) => { root.settings-set-viz-spec-channels(i); }
        set-viz-spec-sensitivity(v) => { root.settings-set-viz-spec-sensitivity(v); }
        set-viz-spec-fft(i) => { root.settings-set-viz-spec-fft(i); }
        set-viz-spec-window(i) => { root.settings-set-viz-spec-window(i); }
        set-viz-spec-scale(i) => { root.settings-set-viz-spec-scale(i); }
        set-viz-spec-freq-min(t) => { root.settings-set-viz-spec-freq-min(t); }
        set-viz-spec-freq-max(t) => { root.settings-set-viz-spec-freq-max(t); }
        set-viz-spec-gain(v) => { root.settings-set-viz-spec-gain(v); }
        set-viz-spec-range(v) => { root.settings-set-viz-spec-range(v); }
        set-viz-spec-boost(v) => { root.settings-set-viz-spec-boost(v); }
        set-viz-spec-palette(i) => { root.settings-set-viz-spec-palette(i); }
        set-viz-spec-max-frames(i) => { root.settings-set-viz-spec-max-frames(i); }
        set-viz-spec-dsd-comp(b) => { root.settings-set-viz-spec-dsd-comp(b); }
        set-viz-spec-cache-mem(b) => { root.settings-set-viz-spec-cache-mem(b); }
        set-viz-spec-cache-disk(b) => { root.settings-set-viz-spec-cache-disk(b); }
        set-viz-sp-channels(i) => { root.settings-set-viz-sp-channels(i); }
        set-viz-sp-sensitivity(v) => { root.settings-set-viz-sp-sensitivity(v); }
        set-viz-sp-bands(t) => { root.settings-set-viz-sp-bands(t); }
        set-viz-sp-freq-scale(i) => { root.settings-set-viz-sp-freq-scale(i); }
        set-viz-sp-level-scale(i) => { root.settings-set-viz-sp-level-scale(i); }
        set-viz-sp-smoothing(v) => { root.settings-set-viz-sp-smoothing(v); }
        set-viz-sp-peak-hold(b) => { root.settings-set-viz-sp-peak-hold(b); }
        set-viz-sp-peak-decay(i) => { root.settings-set-viz-sp-peak-decay(i); }
        set-viz-sp-bar-gap(i) => { root.settings-set-viz-sp-bar-gap(i); }
        set-viz-sp-bar-radius(i) => { root.settings-set-viz-sp-bar-radius(i); }
        set-viz-sp-gradient(b) => { root.settings-set-viz-sp-gradient(b); }
        set-viz-sp-dsd-comp(b) => { root.settings-set-viz-sp-dsd-comp(b); }
        // §10.5: кнопки очистки кэша
        clear-viz-cache => { root.settings-clear-viz-cache(); }
        clear-cover-cache => { root.settings-clear-cover-cache(); }
        clear-all-cache => { root.settings-clear-all-cache(); }
    }

    // ADR-13, §6.15, ТЗ-52: последний потомок AppWindow — рендерится поверх
    // диалога настроек и оверлея блокировки.
    MessageWindow {
        shown: root.msg-shown;
        level: root.msg-level;
        title: root.msg-title;
        body: root.msg-body;
        actions: root.msg-actions;
        action(id) => { root.msg-action(id); }
    }
}
