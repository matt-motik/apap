import { Colors } from "theme.slint";
import {
    TabWidget,
    ComboBox,
    Slider,
    Switch,
    Button,
    ListView,
    CheckBox,
    LineEdit,
    ScrollView,
} from "std-widgets.slint";
import { ModeParamRow, ModeParamsPanel } from "mode_params.slint";
export { ModeParamRow }

export struct ColumnSetting {
    index: int,
    label: string,
    visible: bool,
    width-pct: float,
}

export struct CoverSetting {
    label: string,
    pos: int,
}

component RowLabel inherits Text {
    in property <color> text-color: Colors.text-secondary;
    color: root.text-color;
    font-size: 12px;
    vertical-alignment: center;
}

export component Settings inherits Rectangle {
    in property <bool> open: false;
    // T1.0 §5: динамический список тем (из `themes/*.toml`), текущая тема,
    // метаданные под ComboBox и блокировка Save при невалидной теме.
    in property <[string]> theme-list-model: [""];
    // Двусторонне: самоприсваивание ComboBox при смене модели не рвёт связь (T1.0-B3).
    in-out property <string> theme-current: "";
    // Индекс theme-current в theme-list-model — без него попап ComboBox
    // подсвечивает пункт 0, а не текущую тему (§5.1, T1.0-B4); ставится из
    // Rust вместе с theme-current/theme-list-model (apply_theme_list), не
    // текстом: current-value остаётся источником истины при смене модели.
    in-out property <int> theme-current-index: 0;
    in property <string> theme-name: "";
    in property <string> theme-description: "";
    // Доступность «Сохранить»: в копии есть отличия и нет недопустимых значений (ТЗ-27, §6.9).
    in property <bool> save-enabled: true;
    // Подсказка при наведении на «Сохранить»: параметр и причина; пусто — не показывается (ТЗ-27, §6.9).
    in property <string> save-tooltip: "";
    in property <float> cover-size: 200;
    in property <float> col-info-w: 240;
    in property <float> col-gap: 12;
    in property <bool> minimize-to-tray: false;
    // Индекс N в [10, 30, 60, 120] с (ТЗ-33).
    in property <int> save-interval-idx: 1;
    // Постоянный текст у «Сохранить» при нечитаемом settings.toml; пусто — не показывается (ОВС-6 в, §2.13).
    in property <string> save-notice: "";
    in property <[string]> audio-devices: [];
    in-out property <int> audio-device-idx: -1;
    // AM1.0-B30 (§8 С11): вид DeviceInfoView — «Сейчас: …» + возможности
    // устройства, выбранного в редактируемом режиме (Оптимальный/Строгий:
    // частоты/разрядность/DSD) либо формат микшера сервера (Совместимый).
    // Пустая строка — строка не относится к текущему режиму/состоянию и не
    // показывается.
    in property <string> device-now-line: "";
    in property <string> device-rates-line: "";
    in property <string> device-bits-line: "";
    in property <string> device-dsd-line: "";
    in property <string> device-mixer-line: "";
    in property <string> active-error: "";
    // §6.18, §6.27, ТЗ-41, ТЗ-94: панель построчных настроек режима.
    in property <int> mode-edit-mode: 0;
    in property <[ModeParamRow]> mode-rows: [];
    in property <string> mode-validation: "";
    in property <[ColumnSetting]> columns-cfg: [];
    in-out property <int> selected-col: -1;
    // Активная вкладка диалога (ADR-24, ТЗ-144): «Выбрать устройство» из
    // замка открывает настройки сразу на вкладке «Audio» (индекс 1).
    in-out property <int> settings-tab: 0;
    in property <[CoverSetting]> covers: [];
    in property <string> cover-names: "";
    in property <bool> cover-online: true;
    in-out property <float> resize-dw: 0;
    in-out property <float> resize-dh: 0;

    // ===== Визаулизация (ТЗ §9) =====
    in property <int> viz-mode: 0;
    in property <bool> viz-skip-dsd: true;
    in property <string> viz-error: "";
    in property <bool> viz-freq-min-invalid: false;
    in property <bool> viz-freq-max-invalid: false;
    in property <bool> viz-bands-invalid: false;
    in-out property <string> viz-freq-min-text: "20";
    in-out property <string> viz-freq-max-text: "22000";
    in-out property <string> viz-bands-text: "32";
    in property <int> viz-osc-channels: 1;
    in property <float> viz-osc-sensitivity: 1.0;
    in property <float> viz-osc-line-width: 1.2;
    in property <bool> viz-osc-center-line: false;
    in property <int> viz-osc-max-columns: 2000;
    in property <bool> viz-osc-cache-mem: true;
    in property <bool> viz-osc-cache-disk: true;
    in property <int> viz-spec-channels: 1;
    in property <float> viz-spec-sensitivity: 1.0;
    in property <int> viz-spec-fft: 2;
    in property <int> viz-spec-window: 0;
    in property <int> viz-spec-scale: 1;
    in property <float> viz-spec-gain: 20;
    in property <float> viz-spec-range: 80;
    in property <float> viz-spec-boost: 6;
    in property <int> viz-spec-palette: 1;
    in property <int> viz-spec-max-frames: 4000;
    in property <bool> viz-spec-dsd-comp: true;
    in property <bool> viz-spec-cache-mem: true;
    in property <bool> viz-spec-cache-disk: true;
    in property <int> viz-sp-channels: 1;
    in property <float> viz-sp-sensitivity: 1.0;
    in property <int> viz-sp-freq-scale: 1;
    in property <int> viz-sp-level-scale: 1;
    in property <float> viz-sp-smoothing: 0.7;
    in property <bool> viz-sp-peak-hold: false;
    in property <int> viz-sp-peak-decay: 400;
    in property <int> viz-sp-bar-gap: 2;
    in property <int> viz-sp-bar-radius: 2;
    in property <bool> viz-sp-gradient: true;
    in property <bool> viz-sp-dsd-comp: true;

    callback close();
    callback save-settings();
    callback settings-theme-selected(string);
    callback set-cover-size(float);
    callback set-col-info-w(float);
    callback set-col-gap(float);
    callback set-minimize-to-tray(bool);
    callback set-save-interval(int);
    callback set-audio-device(string);
    callback refresh-devices();
    // §6.18, §6.27, ТЗ-41, ТЗ-94: панель построчных настроек режима.
    callback mode-edit-mode-selected(int);
    callback mode-row-index-changed(int, int);
    callback mode-row-toggled(int, bool);
    callback mode-row-slider-changed(int, float);
    callback toggle-column(int);
    callback reset-columns();
    callback move-col-up(int);
    callback move-col-down(int);
    callback cover-move-up(int);
    callback cover-move-down(int);
    callback cover-names-edited(string);
    callback toggle-cover-online(bool);
    callback set-viz-mode(int);
    callback set-viz-skip-dsd(bool);
    callback reset-viz-type();
    callback set-viz-osc-channels(int);
    callback set-viz-osc-sensitivity(float);
    callback set-viz-osc-line-width(float);
    callback set-viz-osc-center-line(bool);
    callback set-viz-osc-max-columns(int);
    callback set-viz-osc-cache-mem(bool);
    callback set-viz-osc-cache-disk(bool);
    callback set-viz-spec-channels(int);
    callback set-viz-spec-sensitivity(float);
    callback set-viz-spec-fft(int);
    callback set-viz-spec-window(int);
    callback set-viz-spec-scale(int);
    callback set-viz-spec-freq-min(string);
    callback set-viz-spec-freq-max(string);
    callback set-viz-spec-gain(float);
    callback set-viz-spec-range(float);
    callback set-viz-spec-boost(float);
    callback set-viz-spec-palette(int);
    callback set-viz-spec-max-frames(int);
    callback set-viz-spec-dsd-comp(bool);
    callback set-viz-spec-cache-mem(bool);
    callback set-viz-spec-cache-disk(bool);
    callback set-viz-sp-channels(int);
    callback set-viz-sp-sensitivity(float);
    callback set-viz-sp-bands(string);
    callback set-viz-sp-freq-scale(int);
    callback set-viz-sp-level-scale(int);
    callback set-viz-sp-smoothing(float);
    callback set-viz-sp-peak-hold(bool);
    callback set-viz-sp-peak-decay(int);
    callback set-viz-sp-bar-gap(int);
    callback set-viz-sp-bar-radius(int);
    callback set-viz-sp-gradient(bool);
    callback set-viz-sp-dsd-comp(bool);

    // ===== Кэш (§10.5): кнопки очистки ====
    callback clear-viz-cache();
    callback clear-cover-cache();
    callback clear-all-cache();

    // ===== Кэш (§10.5) =====
    in property <string> cache-ram-size: "";
    in property <string> cache-viz-size: "";
    in property <string> cache-cover-size: "";

    visible: root.open;
    background: Colors.bg-overlay;

    TouchArea {
        width: 100%;
        height: 100%;
        scroll-event(event) => {
            EventResult.accept   // <-- останавливает распространение
            }
    }

    dialog := Rectangle {
        // min-width: 540px;
        // min-height: 420px;
        width: 640px + root.resize-dw * 1px;
        height: 480px + root.resize-dh * 1px;

        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        background: Colors.bg-surface;
        border-radius: 8px;
        border-width: 1px;
        border-color: Colors.border-default;

        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            // Content is re-created on every open (`if root.open`): stateful
            // widgets (ComboBox/Slider/CheckBox/LineEdit) keep their internal
            // value otherwise and even break their one-way bindings after a user
            // interaction, so a reused dialog would show stale, un-applied values.
            if root.open: FocusScope {
                init => { self.focus(); }
                key-pressed(event) => {
                    if (event.text == Key.Escape) { root.close(); accept; }
                    reject;
                }
                VerticalLayout {
                    TabWidget {

                        vertical-stretch: 1;
                        current-index <=> root.settings-tab;

                        // ===== General =====
                        Tab {
                            title: @tr("Общие");
                            ScrollView {
                                VerticalLayout {
                                    spacing: 10px;
                                    padding-top: 10px;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 4px;
                                        RowLabel {
                                            text: @tr("Тема");
                                        }

                                        VerticalLayout {
                                            spacing: 2px;
                                            ComboBox {
                                                model: root.theme-list-model;
                                                current-value <=> root.theme-current;
                                                current-index <=> root.theme-current-index;
                                                selected(s) => { debug("settings: theme combo selected"); root.settings-theme-selected(s); }
                                            }

                                            Text {
                                                text: root.theme-name;
                                                color: Colors.text-secondary;
                                                font-size: 11px;
                                            }

                                            Text {
                                                text: root.theme-description;
                                                color: Colors.text-tertiary;
                                                font-size: 11px;
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 4px;
                                        RowLabel {
                                            text: @tr("Размер обложки");
                                        }

                                        Slider {
                                            minimum: 100;
                                            maximum: 400;
                                            value: root.cover-size;
                                            preferred-height: 24px;
                                            changed(v) => { root.set-cover-size(v); }
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 4px;
                                        RowLabel {
                                            text: @tr("Ширина колонки с информацией");
                                        }

                                        Slider {
                                            minimum: 200;
                                            maximum: 400;
                                            value: root.col-info-w;
                                            preferred-height: 24px;
                                            changed(v) => { root.set-col-info-w(v); }
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 4px;
                                        RowLabel {
                                            text: @tr("Промежуток между колонками");
                                        }

                                        Slider {
                                            minimum: 0;
                                            maximum: 20;
                                            value: root.col-gap;
                                            preferred-height: 24px;
                                            changed(v) => { root.set-col-gap(v); }
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 4px;
                                        RowLabel {
                                            text: @tr("Свернуть в трей");
                                        }

                                        CheckBox {
                                            checked: root.minimize-to-tray;
                                            toggled => { root.set-minimize-to-tray(self.checked); }
                                        }

                                        Rectangle {
                                            horizontal-stretch: 1;
                                        }
                                    }

                                    // Параметр N — интервал отложенной записи (ТЗ-33, §2.13).
                                    VerticalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 2px;
                                        HorizontalLayout {
                                            spacing: 4px;
                                            RowLabel {
                                                text: @tr("Сохранять состояние каждые");
                                            }

                                            ComboBox {
                                                model: [@tr("10 с"), @tr("30 с"), @tr("60 с"), @tr("120 с")];
                                                current-index: root.save-interval-idx;
                                                selected(s) => { root.set-save-interval(self.current-index); }
                                            }

                                            Rectangle {
                                                horizontal-stretch: 1;
                                            }
                                        }

                                        Text {
                                            text: @tr("Через сколько секунд после первого изменения громкости, режима, колонок, сортировки, окна и плейлиста они сохраняются на диск. При аварийном завершении программы или отключении питания теряются изменения не старше этого интервала. Настройки из этого окна сохраняются сразу по кнопке „Сохранить“");
                                            color: Colors.text-secondary;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }
                                    }

                                    Rectangle {
                                        vertical-stretch: 1;
                                    }
                                }
                            }
                        }

                        // ===== Audio =====
                        Tab {
                            title: @tr("Аудио");
                            ScrollView {
                                VerticalLayout {
                                    spacing: 10px;
                                    padding-top: 10px;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 4px;
                                        RowLabel {
                                            text: @tr("Устройство");
                                        }

                                        ComboBox {
                                            model: root.audio-devices;
                                            current-index <=> root.audio-device-idx;
                                            selected(s) => { debug("settings: audio combo selected"); root.set-audio-device(s); }
                                        }

                                        Button {
                                            text: @tr("Обновить");
                                            preferred-height: 20px;
                                            clicked => { root.refresh-devices(); }
                                        }
                                    }

                                    // AM1.0-B30 (§8 С11): «Сейчас: …» — заметно, затем
                                    // возможности устройства (Оптимальный/Строгий) либо формат
                                    // микшера сервера (Совместимый); отсутствующая строка
                                    // (`""`) скрыта целиком — без пустых промежутков.
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 4px;
                                        visible: root.device-now-line != "";
                                        RowLabel {
                                            text: root.device-now-line;
                                            text-color: Colors.text-primary;
                                            font-weight: 600;
                                        }

                                        Rectangle {
                                            horizontal-stretch: 1;
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        visible: root.device-rates-line != "";
                                        RowLabel {
                                            text: root.device-rates-line;
                                        }

                                        Rectangle {
                                            horizontal-stretch: 1;
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        visible: root.device-bits-line != "";
                                        RowLabel {
                                            text: root.device-bits-line;
                                        }

                                        Rectangle {
                                            horizontal-stretch: 1;
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        visible: root.device-dsd-line != "";
                                        RowLabel {
                                            text: root.device-dsd-line;
                                        }

                                        Rectangle {
                                            horizontal-stretch: 1;
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        visible: root.device-mixer-line != "";
                                        RowLabel {
                                            text: root.device-mixer-line;
                                        }

                                        Rectangle {
                                            horizontal-stretch: 1;
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 4px;
                                        RowLabel {
                                            color: Colors.text-error;
                                            text: root.active-error;
                                            visible: root.active-error != "";
                                        }
                                    }

                                    Rectangle {
                                        vertical-stretch: 1;
                                    }

                                    // ===== Настройки режима (§6.18, §6.27, ТЗ-41, ТЗ-94) =====
                                    Rectangle {
                                        height: 1px;
                                        background: Colors.border-subtle;
                                    }

                                    RowLabel {
                                        text: @tr("Настройки режима");
                                        font-weight: 600;
                                        text-color: Colors.text-primary;
                                    }

                                    ModeParamsPanel {
                                        edit-mode: root.mode-edit-mode;
                                        rows: root.mode-rows;
                                        validation: root.mode-validation;
                                        edit-mode-selected(i) => { root.mode-edit-mode-selected(i); }
                                        row-index-changed(param, i) => { root.mode-row-index-changed(param, i); }
                                        row-toggled(param, b) => { root.mode-row-toggled(param, b); }
                                        row-slider-changed(param, v) => { root.mode-row-slider-changed(param, v); }
                                    }
                                }
                            }
                        }

                        // ===== Columns =====
                        Tab {
                            title: @tr("Колонки");
                            ScrollView {
                                VerticalLayout {
                                    spacing: 8px;
                                    padding-top: 10px;

                                    // Прокручиваемая таблица колонок
                                    ListView {
                                        vertical-stretch: 1;
                                        for col in root.columns-cfg: Rectangle {
                                            height: 32px;
                                            background: root.selected-col == col.index ? Colors.surface-selected : transparent;

                                            touch := TouchArea {
                                                clicked => { root.selected-col = col.index; }
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                spacing: 4px;

                                                // Видимость
                                                CheckBox {
                                                    checked: col.visible;
                                                    toggled => { root.toggle-column(col.index); }
                                                }

                                                // Название колонки
                                                Text {
                                                    text: col.label;
                                                    color: Colors.text-primary;
                                                    font-size: 14px;
                                                    vertical-alignment: center;
                                                    horizontal-alignment: left;
                                                }

                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                }

                                                // Размер в процентах
                                                Text {
                                                    text: col.visible ? Math.round(col.width-pct) + "%" : "0%";
                                                    color: col.visible ? Colors.text-primary : Colors.text-dim;
                                                    font-size: 14px;
                                                    vertical-alignment: center;
                                                    horizontal-alignment: right;
                                                    min-width: 40px;
                                                }
                                            }
                                        }
                                    }

                                    // Кнопки перемещения и сброса
                                    HorizontalLayout {
                                        padding-top: 14px;
                                        padding-bottom: 14px;
                                        spacing: 8px;
                                        Button {
                                            text: "\u{25B2}";
                                            preferred-height: 20px;
                                            preferred-width: 40px;
                                            enabled: root.selected-col > 0;
                                            clicked => { root.move-col-up(root.selected-col); }
                                        }

                                        Button {
                                            text: "\u{25BC}";
                                            preferred-height: 20px;
                                            preferred-width: 40px;
                                            enabled: root.selected-col >= 0 && root.selected-col < root.columns-cfg.length - 1;
                                            clicked => { root.move-col-down(root.selected-col); }
                                        }

                                        Rectangle {
                                            horizontal-stretch: 1;
                                        }

                                        Button {
                                            text: @tr("Сбросить");
                                            preferred-height: 20px;
                                            clicked => { root.reset-columns(); }
                                        }
                                    }
                                }
                            }
                        }

                        // ===== Covers =====
                        Tab {
                            title: @tr("Обложки");
                            ScrollView {
                                VerticalLayout {
                                    spacing: 8px;
                                    padding-top: 10px;

                                    RowLabel {
                                        text: @tr("Приоритет источников обложки");
                                    }

                                    ListView {
                                        vertical-stretch: 1;
                                        for cover-row in root.covers: Rectangle {
                                            height: 32px;

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                spacing: 4px;

                                                Text {
                                                    text: cover-row.label;
                                                    color: Colors.text-primary;
                                                    font-size: 14px;
                                                    vertical-alignment: center;
                                                    horizontal-stretch: 1;
                                                    overflow: elide;
                                                }

                                                Button {
                                                    text: "\u{25B2}";
                                                    preferred-height: 28px;
                                                    preferred-width: 32px;
                                                    enabled: cover-row.pos > 0;
                                                    clicked => { root.cover-move-up(cover-row.pos); }
                                                }

                                                Button {
                                                    text: "\u{25BC}";
                                                    preferred-height: 28px;
                                                    preferred-width: 32px;
                                                    enabled: cover-row.pos < root.covers.length - 1;
                                                    clicked => { root.cover-move-down(cover-row.pos); }
                                                }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        spacing: 4px;
                                        RowLabel {
                                            text: @tr("Имена файлов обложек в папке (через запятую)");
                                        }

                                        Rectangle {
                                            horizontal-stretch: 1;
                                        }
                                    }

                                    LineEdit {
                                        preferred-height: 32px;
                                        text: root.cover-names;
                                        edited(t) => { root.cover-names-edited(t); }
                                    }

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        spacing: 4px;
                                        RowLabel {
                                            text: @tr("Искать в интернете (iTunes)");
                                        }

                                        CheckBox {
                                            checked: root.cover-online;
                                            toggled => { root.toggle-cover-online(self.checked); }
                                        }

                                        Rectangle {
                                            horizontal-stretch: 1;
                                        }
                                    }
                                }
                            }
                        }

                        // ===== Visualization (ТЗ §9) =====
                        Tab {
                            title: "Visualization";
                            ScrollView {
                                VerticalLayout {
                                    spacing: 8px;
                                    padding-top: 10px;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 4px;
                                        RowLabel {
                                            text: "Type";
                                            min-width: 170px;
                                        }

                                        ComboBox {
                                            model: ["Off", "Oscilloscope", "Spectrogram", "Spectrum"];
                                            current-index: root.viz-mode;
                                            selected(s) => { root.set-viz-mode(self.current-index); }
                                        }

                                        Rectangle {
                                            horizontal-stretch: 1;
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 4px;
                                        RowLabel {
                                            text: "Skip fulltrack for DSD";
                                            min-width: 170px;
                                        }

                                        CheckBox {
                                            checked: root.viz-skip-dsd;
                                            toggled => { root.set-viz-skip-dsd(self.checked); }
                                        }

                                        Rectangle {
                                            horizontal-stretch: 1;
                                        }
                                    }

                                    // Прокручиваемый блок настроек текущего типа.
                                    VerticalLayout {
                                        vertical-stretch: 1;
                                        spacing: 8px;

                                        // ----- Осциллограмма -----
                                        if root.viz-mode == 1: VerticalLayout {
                                            spacing: 8px;
                                            RowLabel {
                                                text: "Settings: Oscilloscope";
                                                text-color: Colors.accent;
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                spacing: 4px;
                                                RowLabel {
                                                    text: "Channels";
                                                    min-width: 170px;
                                                }

                                                ComboBox {
                                                    model: ["Mono", "Stereo"];
                                                    current-index: root.viz-osc-channels;
                                                    selected(s) => { root.set-viz-osc-channels(self.current-index); }
                                                }

                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                spacing: 4px;
                                                RowLabel {
                                                    text: "Sensitivity";
                                                    min-width: 170px;
                                                }

                                                Slider {
                                                    minimum: 0.01;
                                                    maximum: 2;
                                                    value: root.viz-osc-sensitivity;
                                                    preferred-height: 24px;
                                                    changed(v) => { root.set-viz-osc-sensitivity(v); }
                                                }

                                                Text {
                                                    text: Math.round(root.viz-osc-sensitivity * 100) / 100;
                                                    color: Colors.text-secondary;
                                                    width: 56px;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                spacing: 4px;
                                                RowLabel {
                                                    text: "Line width";
                                                    min-width: 170px;
                                                }

                                                Slider {
                                                    minimum: 0.5;
                                                    maximum: 4.0;
                                                    value: root.viz-osc-line-width;
                                                    preferred-height: 24px;
                                                    changed(v) => { root.set-viz-osc-line-width(v); }
                                                }

                                                Text {
                                                    text: Math.round(root.viz-osc-line-width * 10) / 10;
                                                    color: Colors.text-secondary;
                                                    width: 56px;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                spacing: 4px;
                                                RowLabel {
                                                    text: "Max columns";
                                                    min-width: 170px;
                                                }

                                                Slider {
                                                    minimum: 512;
                                                    maximum: 8192;
                                                    value: root.viz-osc-max-columns;
                                                    preferred-height: 24px;
                                                    changed(v) => { root.set-viz-osc-max-columns(Math.round(v)); }
                                                }

                                                Text {
                                                    text: Math.round(root.viz-osc-max-columns);
                                                    color: Colors.text-secondary;
                                                    width: 56px;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                spacing: 4px;
                                                RowLabel {
                                                    text: "Draw center line";
                                                    min-width: 170px;
                                                }

                                                CheckBox {
                                                    checked: root.viz-osc-center-line;
                                                    toggled => { root.set-viz-osc-center-line(self.checked); }
                                                }

                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                spacing: 4px;
                                                RowLabel {
                                                    text: "Cache in memory";
                                                    min-width: 170px;
                                                }

                                                CheckBox {
                                                    checked: root.viz-osc-cache-mem;
                                                    toggled => { root.set-viz-osc-cache-mem(self.checked); }
                                                }

                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                spacing: 4px;
                                                RowLabel {
                                                    text: "Cache on disk";
                                                    min-width: 170px;
                                                }

                                                CheckBox {
                                                    checked: root.viz-osc-cache-disk;
                                                    toggled => { root.set-viz-osc-cache-disk(self.checked); }
                                                }

                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                }
                                            }
                                        }

                                        // ----- Спектрограмма -----
                                        if root.viz-mode == 2: VerticalLayout {
                                            spacing: 8px;
                                            RowLabel {
                                                text: "Settings: Spectrogram";
                                                text-color: Colors.accent;
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                spacing: 4px;
                                                RowLabel {
                                                    text: "Channels";
                                                    min-width: 170px;
                                                }

                                                ComboBox {
                                                    model: ["Mono", "Stereo"];
                                                    current-index: root.viz-spec-channels;
                                                    selected(s) => { root.set-viz-spec-channels(self.current-index); }
                                                }

                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                spacing: 4px;
                                                RowLabel {
                                                    text: "Sensitivity";
                                                    min-width: 170px;
                                                }

                                                Slider {
                                                    minimum: 0.01;
                                                    maximum: 20;
                                                    value: root.viz-spec-sensitivity;
                                                    preferred-height: 24px;
                                                    changed(v) => { root.set-viz-spec-sensitivity(v); }
                                                }

                                                Text {
                                                    text: Math.round(root.viz-spec-sensitivity * 100) / 100;
                                                    color: Colors.text-secondary;
                                                    width: 56px;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                spacing: 4px;
                                                RowLabel {
                                                    text: "FFT size";
                                                    min-width: 170px;
                                                }

                                                ComboBox {
                                                    model: ["512", "1024", "2048", "4096", "8192"];
                                                    current-index: root.viz-spec-fft;
                                                    selected(s) => { root.set-viz-spec-fft(self.current-index); }
                                                }

                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                spacing: 4px;
                                                RowLabel {
                                                    text: "Window type";
                                                    min-width: 170px;
                                                }

                                                ComboBox {
                                                    model: ["Hann", "Hamming", "Blackman"];
                                                    current-index: root.viz-spec-window;
                                                    selected(s) => { root.set-viz-spec-window(self.current-index); }
                                                }

                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                spacing: 4px;
                                                RowLabel {
                                                    text: "Freq scale";
                                                    min-width: 170px;
                                                }

                                                ComboBox {
                                                    model: ["Linear", "Log", "Mel"];
                                                    current-index: root.viz-spec-scale;
                                                    selected(s) => { root.set-viz-spec-scale(self.current-index); }
                                                }

                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                spacing: 4px;
                                                RowLabel {
                                                    text: "Freq min (Hz)";
                                                    min-width: 170px;
                                                }

                                                Rectangle {
                                                    border-width: root.viz-freq-min-invalid ? 2px : 0px;
                                                    border-color: Colors.text-error;
                                                    border-radius: 6px;
                                                    preferred-width: 100px;
                                                    LineEdit {
                                                        height: 24px;
                                                        text <=> root.viz-freq-min-text;
                                                        edited(t) => { root.set-viz-spec-freq-min(t); }
                                                    }
                                                }

                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                spacing: 4px;
                                                RowLabel {
                                                    text: "Freq max (Hz)";
                                                    min-width: 170px;
                                                }

                                                Rectangle {
                                                    border-width: root.viz-freq-max-invalid ? 2px : 0px;
                                                    border-color: Colors.text-error;
                                                    border-radius: 6px;
                                                    preferred-width: 100px;
                                                    LineEdit {
                                                        height: 24px;
                                                        text <=> root.viz-freq-max-text;
                                                        edited(t) => { root.set-viz-spec-freq-max(t); }
                                                    }
                                                }

                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                spacing: 4px;
                                                RowLabel {
                                                    text: "Gain (dB)";
                                                    min-width: 170px;
                                                }

                                                Slider {
                                                    minimum: -40;
                                                    maximum: 100;
                                                    value: root.viz-spec-gain;
                                                    preferred-height: 24px;
                                                    changed(v) => { root.set-viz-spec-gain(v); }
                                                }

                                                Text {
                                                    text: Math.round(root.viz-spec-gain);
                                                    color: Colors.text-secondary;
                                                    width: 56px;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                spacing: 4px;
                                                RowLabel {
                                                    text: "Range (dB)";
                                                    min-width: 170px;
                                                }

                                                Slider {
                                                    minimum: 1;
                                                    maximum: 200;
                                                    value: root.viz-spec-range;
                                                    preferred-height: 24px;
                                                    changed(v) => { root.set-viz-spec-range(v); }
                                                }

                                                Text {
                                                    text: Math.round(root.viz-spec-range);
                                                    color: Colors.text-secondary;
                                                    width: 56px;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                spacing: 4px;
                                                RowLabel {
                                                    text: "High boost (dB/dec)";
                                                    min-width: 170px;
                                                }

                                                Slider {
                                                    minimum: 0;
                                                    maximum: 60;
                                                    value: root.viz-spec-boost;
                                                    preferred-height: 24px;
                                                    changed(v) => { root.set-viz-spec-boost(v); }
                                                }

                                                Text {
                                                    text: Math.round(root.viz-spec-boost * 10) / 10;
                                                    color: Colors.text-secondary;
                                                    width: 56px;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                spacing: 4px;
                                                RowLabel {
                                                    text: "Palette";
                                                    min-width: 170px;
                                                }

                                                ComboBox {
                                                    model: [
                                                        "Solid",
                                                        "Magma",
                                                        "Viridis",
                                                        "Plasma",
                                                        "Inferno",
                                                        "Gray",
                                                        "Thermal",
                                                        "Rainbow"
                                                    ];
                                                    current-index: root.viz-spec-palette;
                                                    selected(s) => { root.set-viz-spec-palette(self.current-index); }
                                                }

                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                spacing: 4px;
                                                RowLabel {
                                                    text: "Max frames";
                                                    min-width: 170px;
                                                }

                                                Slider {
                                                    minimum: 512;
                                                    maximum: 8192;
                                                    value: root.viz-spec-max-frames;
                                                    preferred-height: 24px;
                                                    changed(v) => { root.set-viz-spec-max-frames(Math.round(v)); }
                                                }

                                                Text {
                                                    text: Math.round(root.viz-spec-max-frames);
                                                    color: Colors.text-secondary;
                                                    width: 56px;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                spacing: 4px;
                                                RowLabel {
                                                    text: "DSD CIC compensation";
                                                    min-width: 170px;
                                                }

                                                CheckBox {
                                                    checked: root.viz-spec-dsd-comp;
                                                    toggled => { root.set-viz-spec-dsd-comp(self.checked); }
                                                }

                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                spacing: 4px;
                                                RowLabel {
                                                    text: "Cache in memory";
                                                    min-width: 170px;
                                                }

                                                CheckBox {
                                                    checked: root.viz-spec-cache-mem;
                                                    toggled => { root.set-viz-spec-cache-mem(self.checked); }
                                                }

                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                spacing: 4px;
                                                RowLabel {
                                                    text: "Cache on disk";
                                                    min-width: 170px;
                                                }

                                                CheckBox {
                                                    checked: root.viz-spec-cache-disk;
                                                    toggled => { root.set-viz-spec-cache-disk(self.checked); }
                                                }

                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                }
                                            }
                                        }

                                        // ----- Анализатор спектра -----
                                        if root.viz-mode == 3: VerticalLayout {

                                            spacing: 8px;
                                            RowLabel {
                                                text: "Settings: Spectrum";
                                                text-color: Colors.accent;
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                spacing: 4px;
                                                RowLabel {
                                                    text: "Channels";
                                                    min-width: 170px;
                                                }

                                                ComboBox {
                                                    model: ["Mono", "Stereo"];
                                                    current-index: root.viz-sp-channels;
                                                    selected(s) => { root.set-viz-sp-channels(self.current-index); }
                                                }

                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                spacing: 4px;
                                                RowLabel {
                                                    text: "Sensitivity";
                                                    min-width: 170px;
                                                }

                                                Slider {
                                                    minimum: 0.01;
                                                    maximum: 20;
                                                    value: root.viz-sp-sensitivity;
                                                    preferred-height: 24px;
                                                    changed(v) => { root.set-viz-sp-sensitivity(v); }
                                                }

                                                Text {
                                                    text: Math.round(root.viz-sp-sensitivity * 100) / 100;
                                                    color: Colors.text-secondary;
                                                    width: 56px;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 4px;
                                                spacing: 4px;
                                                RowLabel {
                                                    text: "Bands (4-128)";
                                                    min-width: 170px;
                                                }

                                                Rectangle {
                                                    border-width: root.viz-bands-invalid ? 2px : 0px;
                                                    border-color: Colors.text-error;
                                                    border-radius: 6px;
                                                    preferred-width: 100px;
                                                    LineEdit {
                                                        height: 24px;
                                                        text <=> root.viz-bands-text;
                                                        edited(t) => { root.set-viz-sp-bands(t); }
                                                    }
                                                }

                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                spacing: 4px;
                                                RowLabel {
                                                    text: "Freq scale";
                                                    min-width: 170px;
                                                }

                                                ComboBox {
                                                    model: ["Linear", "Log", "Mel"];
                                                    current-index: root.viz-sp-freq-scale;
                                                    selected(s) => { root.set-viz-sp-freq-scale(self.current-index); }
                                                }

                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                spacing: 4px;
                                                RowLabel {
                                                    text: "Level scale";
                                                    min-width: 170px;
                                                }

                                                ComboBox {
                                                    model: ["Linear", "Log"];
                                                    current-index: root.viz-sp-level-scale;
                                                    selected(s) => { root.set-viz-sp-level-scale(self.current-index); }
                                                }

                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                spacing: 4px;
                                                RowLabel {
                                                    text: "Smoothing";
                                                    min-width: 170px;
                                                }

                                                Slider {
                                                    minimum: 0.0;
                                                    maximum: 0.99;
                                                    value: root.viz-sp-smoothing;
                                                    preferred-height: 24px;
                                                    changed(v) => { root.set-viz-sp-smoothing(v); }
                                                }

                                                Text {
                                                    text: Math.round(root.viz-sp-smoothing * 100) / 100;
                                                    color: Colors.text-secondary;
                                                    width: 56px;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                spacing: 4px;
                                                RowLabel {
                                                    text: "Peak hold";
                                                    min-width: 170px;
                                                }

                                                CheckBox {
                                                    checked: root.viz-sp-peak-hold;
                                                    toggled => { root.set-viz-sp-peak-hold(self.checked); }
                                                }

                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                spacing: 4px;
                                                RowLabel {
                                                    text: "Peak decay (ms)";
                                                    min-width: 170px;
                                                }

                                                Slider {
                                                    minimum: 50;
                                                    maximum: 2000;
                                                    value: root.viz-sp-peak-decay;
                                                    preferred-height: 24px;
                                                    changed(v) => { root.set-viz-sp-peak-decay(Math.round(v)); }
                                                }

                                                Text {
                                                    text: Math.round(root.viz-sp-peak-decay);
                                                    color: Colors.text-secondary;
                                                    width: 56px;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                spacing: 4px;
                                                RowLabel {
                                                    text: "Bar gap (px)";
                                                    min-width: 170px;
                                                }

                                                Slider {
                                                    minimum: 0;
                                                    maximum: 10;
                                                    value: root.viz-sp-bar-gap;
                                                    preferred-height: 24px;
                                                    changed(v) => { root.set-viz-sp-bar-gap(Math.round(v)); }
                                                }

                                                Text {
                                                    text: Math.round(root.viz-sp-bar-gap);
                                                    color: Colors.text-secondary;
                                                    width: 56px;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                spacing: 4px;
                                                RowLabel {
                                                    text: "Bar radius (px)";
                                                    min-width: 170px;
                                                }

                                                Slider {
                                                    minimum: 0;
                                                    maximum: 12;
                                                    value: root.viz-sp-bar-radius;
                                                    preferred-height: 24px;
                                                    changed(v) => { root.set-viz-sp-bar-radius(Math.round(v)); }
                                                }

                                                Text {
                                                    text: Math.round(root.viz-sp-bar-radius);
                                                    color: Colors.text-secondary;
                                                    width: 56px;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                spacing: 4px;
                                                RowLabel {
                                                    text: "Gradient";
                                                    min-width: 170px;
                                                }

                                                CheckBox {
                                                    checked: root.viz-sp-gradient;
                                                    toggled => { root.set-viz-sp-gradient(self.checked); }
                                                }

                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                spacing: 4px;
                                                RowLabel {
                                                    text: "DSD CIC compensation";
                                                    min-width: 170px;
                                                }

                                                CheckBox {
                                                    checked: root.viz-sp-dsd-comp;
                                                    toggled => { root.set-viz-sp-dsd-comp(self.checked); }
                                                }

                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                }
                                            }
                                        }

                                        // ----- Отключено -----
                                        if root.viz-mode == 0: VerticalLayout {
                                            spacing: 8px;
                                            RowLabel {
                                                text: "Visualization is disabled (placeholder only).";
                                                text-color: Colors.text-tertiary;
                                            }
                                        }
                                    }

                                    // Валидация + сброс
                                    RowLabel {
                                        text: root.viz-error;
                                        text-color: Colors.text-error;
                                        wrap: word-wrap;
                                        visible: root.viz-error != "";
                                    }

                                    Button {
                                        text: "Reset type settings";
                                        preferred-height: 28px;
                                        clicked => { debug("settings: reset viz type"); root.reset-viz-type(); }
                                    }
                                }
                            }
                        }

                        // ===== Cache (§10.5) =====
                        Tab {
                            title: "Cache";
                            ScrollView {
                                VerticalLayout {
                                    spacing: 10px;
                                    padding-top: 10px;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 4px;
                                        RowLabel {
                                            text: "RAM-кэш визуализации";
                                        }

                                        RowLabel {
                                            text: root.cache-ram-size;
                                            text-color: Colors.text-primary;
                                        }

                                        Rectangle {
                                            horizontal-stretch: 1;
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 4px;
                                        RowLabel {
                                            text: "Кэш визуализации (диск)";
                                        }

                                        RowLabel {
                                            text: root.cache-viz-size;
                                            text-color: Colors.text-primary;
                                        }

                                        Rectangle {
                                            horizontal-stretch: 1;
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 4px;
                                        RowLabel {
                                            text: "Кэш обложек";
                                        }

                                        RowLabel {
                                            text: root.cache-cover-size;
                                            text-color: Colors.text-primary;
                                        }

                                        Rectangle {
                                            horizontal-stretch: 1;
                                        }
                                    }
                                    // Кнопки очистки (§10.5). Подпись RAM/Total уточняет объём:
                                    // viz очищает RAM+диск визуализации; covers — диск обложек.
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 4px;
                                        RowLabel {
                                            text: "";
                                        }

                                        Button {
                                            text: "Очистить кэш визуализации";
                                            preferred-height: 28px;
                                            clicked => { root.clear-viz-cache(); }
                                        }

                                        Button {
                                            text: "Очистить кэш обложек";
                                            preferred-height: 28px;
                                            clicked => { root.clear-cover-cache(); }
                                        }

                                        Button {
                                            text: "Очистить всё";
                                            preferred-height: 28px;
                                            clicked => { root.clear-all-cache(); }
                                        }
                                    }

                                    // Постоянное пояснение: очистка кэша необратима и не входит
                                    // в черновик диалога (§2.13, ТЗ-34).
                                    VerticalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: "Очистка выполняется сразу и не отменяется кнопкой „Отмена“";
                                            color: Colors.text-secondary;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }
                                    }

                                    Rectangle {
                                        vertical-stretch: 1;
                                    }
                                }
                            }
                        }
                    }
                    // Кнопки Save / Cancel внизу диалога
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        Text {
                            horizontal-stretch: 1;
                            text: root.save-notice;
                            color: Colors.text-secondary;
                            font-size: 11px;
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }

                        Button {
                            text: "Cancel";
                            preferred-height: 28px;
                            clicked => { root.close(); }
                        }

                        // Наведение ловит внешняя TouchArea: неактивная кнопка сама
                        // его не сообщает, а клик по активной кнопке получает
                        // вложенный Button (ТЗ-27, §6.9).
                        save-hover := TouchArea {
                            horizontal-stretch: 0;

                            HorizontalLayout {
                                Button {
                                    text: "Save";
                                    preferred-height: 28px;
                                    enabled: root.save-enabled;
                                    clicked => { root.save-settings(); }
                                }
                            }

                            // Подсказка с параметром и причиной (ТЗ-27): вне раскладки,
                            // над кнопкой, правым краем по кнопке — остаётся в пределах диалога.
                            if save-hover.has-hover && root.save-tooltip != "": Rectangle {
                                y: -self.height - 6px;
                                x: parent.width - self.width;
                                width: 260px;
                                height: save-hint-text.preferred-height + 12px;
                                background: Colors.bg-elevated;
                                border-color: Colors.border-default;
                                border-width: 1px;
                                border-radius: 4px;
                                z: 10;

                                save-hint-text := Text {
                                    text: root.save-tooltip;
                                    color: Colors.text-secondary;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                    x: 8px;
                                    y: 6px;
                                    width: parent.width - 16px;
                                }
                            }
                        }
                    }
                }
            }
        }

        // Ресайз-хэндл
        Rectangle {
            x: dialog.width - 16px;
            y: dialog.height - 16px;
            width: 16px;
            height: 16px;
            background: Colors.border-default;

            private property <float> start-dw: 0;
            private property <float> start-dh: 0;

            TouchArea {
                vertical-stretch: 1;
                horizontal-stretch: 1;
                mouse-cursor: se-resize;

                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        parent.start-dw = root.resize-dw;
                        parent.start-dh = root.resize-dh;
                    }
                    if (event.kind == PointerEventKind.move && self.pressed) {
                        let dx = (self.mouse-x - self.pressed-x) / 1px;
                        let dy = (self.mouse-y - self.pressed-y) / 1px;
                        root.resize-dw = (parent.start-dw + dx).max(0);
                        root.resize-dh = (parent.start-dh + dy).max(0);
                    }
                }
            }
        }
    }
}
