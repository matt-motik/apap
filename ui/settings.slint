import { Colors } from "theme.slint";
import { TabWidget, ComboBox, Slider, Switch, Button, ListView, CheckBox, LineEdit } from "std-widgets.slint";

export struct ColumnSetting {
    index: int,
    label: string,
    visible: bool,
    width-pct: float,
}

export struct CoverSetting {
    label: string,
    pos: int,
}

component RowLabel inherits Text {
    in property <color> text-color: Colors.text-secondary;
    color: root.text-color;
    font-size: 12px;
    vertical-alignment: center;
}

export component Settings inherits Rectangle {
    in property <bool> open: false;
    in property <int> theme: 0;
    in property <float> cover-size: 200;
    in property <float> col-info-w: 240;
    in property <float> col-gap: 12;
    in property <bool> minimize-to-tray: false;
    in property <[string]> audio-devices: [];
    in property <int> audio-device-idx: -1;
    in property <string> active-device: "";
    in property <string> codec-info: "";
    in property <string> active-error: "";
    in property <[ColumnSetting]> columns-cfg: [];
    in-out property <int> selected-col: -1;
    in property <[CoverSetting]> covers: [];
    in property <string> cover-names: "";
    in property <bool> cover-online: true;
    in-out property <float> resize-dw: 0;
    in-out property <float> resize-dh: 0;

    callback close();
    callback save-settings();
    callback set-theme(int);
    callback set-cover-size(float);
    callback set-col-info-w(float);
    callback set-col-gap(float);
    callback set-minimize-to-tray(bool);
    callback set-audio-device(string);
    callback refresh-devices();
    callback toggle-column(int);
    callback reset-columns();
    callback move-col-up(int);
    callback move-col-down(int);
    callback clear-playlist();
    callback remove-current();
    callback cover-move-up(int);
    callback cover-move-down(int);
    callback cover-names-edited(string);
    callback toggle-cover-online(bool);

    visible: root.open;
    background: Colors.bg-overlay;

    TouchArea { clicked => { debug("settings: backdrop click (outside dialog)"); } }

    dialog := Rectangle {
        min-width: 540px;
        min-height: 420px;
        width: 640px + root.resize-dw * 1px;
        height: 480px + root.resize-dh * 1px;

        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        background: Colors.bg-surface;
        border-radius: 8px;
        border-width: 1px;
        border-color: Colors.border-default;

        VerticalLayout {
            padding: 12px;
            spacing: 8px;

            TabWidget {
                vertical-stretch: 1;

                // ===== General =====
                Tab {
                    title: "General";
                    VerticalLayout {
                        spacing: 10px;
                        padding-top: 10px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;
                            RowLabel { text: "Theme"; }
                            ComboBox {
                                model: ["Dark", "Light"];
                                current-index: root.theme;
                                selected(s) => { debug("settings: theme combo selected"); root.set-theme(s == "Light" ? 1 : 0); }
                            }
                        }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;
                            RowLabel { text: "Cover size"; }
                            Slider {
                                minimum: 100;
                                maximum: 400;
                                value: root.cover-size;
                                preferred-height: 24px;
                                changed(v) => { root.set-cover-size(v); }
                            }
                        }

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;
                            RowLabel { text: "Info column width"; }
                            Slider {
                                minimum: 200;
                                maximum: 400;
                                value: root.col-info-w;
                                preferred-height: 24px;
                                changed(v) => { root.set-col-info-w(v); }
                            }
                        }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;
                            RowLabel { text: "Column gap"; }
                            Slider {
                                minimum: 0;
                                maximum: 20;
                                value: root.col-gap;
                                preferred-height: 24px;
                                changed(v) => { root.set-col-gap(v); }
                            }
                        }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;
                            RowLabel { text: "Minimize to tray"; }
                            CheckBox {
                                checked: root.minimize-to-tray;
                                toggled => { root.set-minimize-to-tray(self.checked); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }

                // ===== Audio =====
                Tab {
                    title: "Audio";
                    VerticalLayout {
                        spacing: 10px;
                        padding-top: 4px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;
                            RowLabel { text: "Audio device"; }
                            ComboBox {
                                model: root.audio-devices;
                                current-index: root.audio-device-idx;
                                selected(s) => { debug("settings: audio combo selected"); root.set-audio-device(s); }
                            }
                        }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;
                            RowLabel { text: ""; }
                            Button {
                                text: "Refresh devices";
                                preferred-height: 28px;
                                clicked => { root.refresh-devices(); }
                            }
                        }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;                        
                            RowLabel { text: "Active:"; }
                            RowLabel {
                                text: root.active-device;
                                text-color: Colors.text-primary;
                            }
                        }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;
                            RowLabel { text: root.codec-info;  }
                        }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;
                            RowLabel {
                                color: Colors.text-error;
                                text: root.active-error;
                                visible: root.active-error != "";

                            }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                    
                }

                // ===== Columns =====
                Tab {
                    title: "Columns";
                    VerticalLayout {
                        spacing: 8px;
                        padding-top: 4px;

                        // Прокручиваемая таблица колонок
                        ListView {
                            vertical-stretch: 1;
                            for col in root.columns-cfg : Rectangle {
                                height: 32px;
                                background: root.selected-col == col.index ? Colors.surface-selected : transparent;

                                touch := TouchArea {
                                    clicked => { root.selected-col = col.index; }
                                }

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 4px;

                                    // Видимость
                                    CheckBox {
                                        checked: col.visible;
                                        toggled => { root.toggle-column(col.index); }
                                    }

                                    // Название колонки
                                    Text {
                                        text: col.label;
                                        color: Colors.text-primary;
                                        font-size: 14px;
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; }

                                    // Размер в процентах
                                    Text {
                                        text: col.visible ? Math.round(col.width-pct) + "%" : "0%";
                                        color: col.visible ? Colors.text-primary : Colors.text-dim;
                                        font-size: 14px;
                                        vertical-alignment: center;
                                        horizontal-alignment: right;
                                        min-width: 40px;
                                    }
                                }
                            }
                        }

                        // Кнопки перемещения и сброса
                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "\u{25B2}";
                                preferred-height: 28px;
                                preferred-width: 40px;
                                enabled: root.selected-col > 0;
                                clicked => { root.move-col-up(root.selected-col); }
                            }
                            Button {
                                text: "\u{25BC}";
                                preferred-height: 28px;
                                preferred-width: 40px;
                                enabled: root.selected-col >= 0 && root.selected-col < root.columns-cfg.length - 1;
                                clicked => { root.move-col-down(root.selected-col); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Button {
                                text: "Reset";
                                preferred-height: 28px;
                                clicked => { root.reset-columns(); }
                            }
                        }
                    }
                }

                // ===== Covers =====
                Tab {
                    title: "Covers";
                    VerticalLayout {
                        spacing: 8px;
                        padding-top: 4px;

                        RowLabel { text: "Cover source priority"; }

                        ListView {
                            vertical-stretch: 1;
                            for cover-row in root.covers : Rectangle {
                                height: 32px;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 4px;

                                    Text {
                                        text: cover-row.label;
                                        color: Colors.text-primary;
                                        font-size: 14px;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }

                                    Button {
                                        text: "\u{25B2}";
                                        preferred-height: 28px;
                                        preferred-width: 32px;
                                        enabled: cover-row.pos > 0;
                                        clicked => { root.cover-move-up(cover-row.pos); }
                                    }
                                    Button {
                                        text: "\u{25BC}";
                                        preferred-height: 28px;
                                        preferred-width: 32px;
                                        enabled: cover-row.pos < root.covers.length - 1;
                                        clicked => { root.cover-move-down(cover-row.pos); }
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            padding-left: 8px;
                            spacing: 4px;
                            RowLabel { text: "Folder cover filenames (comma-separated)"; }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        LineEdit {
                            preferred-height: 32px;
                            text: root.cover-names;
                            edited(t) => { root.cover-names-edited(t); }
                        }

                        HorizontalLayout {
                            padding-left: 8px;
                            spacing: 4px;
                            RowLabel { text: "Search the internet (iTunes)"; }
                            CheckBox {
                                checked: root.cover-online;
                                toggled => { root.toggle-cover-online(self.checked); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }

                // ===== Playlist =====
                Tab {
                    title: "Playlist";
                    VerticalLayout {
                        spacing: 10px;
                        padding-top: 4px;
                        Button {
                            text: "Remove current track";
                            preferred-height: 28px;
                            clicked => { root.remove-current(); }
                        }
                        Button {
                            text: "Clear playlist";
                            preferred-height: 28px;
                            clicked => { root.clear-playlist(); }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }

            // Кнопки Save / Cancel внизу диалога
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: "Cancel";
                    preferred-height: 28px;
                    clicked => { debug("settings: Cancel button clicked"); root.close(); }
                }
                Button {
                    text: "Save";
                    preferred-height: 28px;
                    clicked => { debug("settings: Save button clicked"); root.save-settings(); }
                }
            }
        }

        // Escape — отмена
        FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.close();
                    accept;
                }
                reject;
            }
        }

        // Ресайз-хэндл
        Rectangle {
            x: dialog.width - 16px;
            y: dialog.height - 16px;
            width: 16px;
            height: 16px;
            background: Colors.border-default;

            private property <float> start-dw: 0;
            private property <float> start-dh: 0;

            TouchArea {
                vertical-stretch: 1;
                horizontal-stretch: 1;
                mouse-cursor: se-resize;

                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        parent.start-dw = root.resize-dw;
                        parent.start-dh = root.resize-dh;
                    }
                    if (event.kind == PointerEventKind.move && self.pressed) {
                        let dx = (self.mouse-x - self.pressed-x) / 1px;
                        let dy = (self.mouse-y - self.pressed-y) / 1px;
                        root.resize-dw = (parent.start-dw + dx).max(0);
                        root.resize-dh = (parent.start-dh + dy).max(0);
                    }
                }
            }
        }
    }
}
