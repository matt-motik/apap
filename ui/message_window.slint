import { Colors } from "theme.slint";
import { Button, ScrollView } from "std-widgets.slint";

// Кнопка окна сообщения (ADR-13, §6.15, редизайн замка — ТЗ-46, ТЗ-144):
// элемент — подпись кнопки и её action-id, который `action()` передаёт как
// есть — значение решает Rust-сторона (`src/core/messages.rs::MessageAction`,
// `src/app/mod.rs`). Массив — порядок рендера слева направо; первый элемент
// — основная кнопка окна (Enter), последний — закрывающая (Esc); если
// элемент один, он и основная, и закрывающая.
export struct MessageActionItem {
    label: string,
    action-id: int,
}

// Окно сообщения (ADR-13, §6.15, ТЗ-52, ТЗ-46, ТЗ-144). Последний потомок
// AppWindow — рендерится поверх главного окна и диалога настроек. Пока
// показано, AppCore держит UiGate::block(Message) (ТЗ-23), поэтому это окно
// само недоступности не проверяет.
//
// `level` — MessageLevel (ТЗ-52): 0 = Info, 1 = Warning, 2 = Error.
// `actions` — переменный по длине и составу набор кнопок (AM1.0-B14 шаг 4,
// заменяет бывшие фиксированные `retry`/`primary-label`); рендерится слева
// направо в порядке массива. Кнопки без акцента стиля — как в окне настроек
// (SP1.0-B3); Enter/Esc — через обработчик клавиш, а не через свойство
// кнопки (см. `MessageActionItem`).
export component MessageWindow inherits Rectangle {
    in property <bool> shown: false;
    in property <int> level: 2;
    in property <string> title: "";
    in property <string> body: "";
    in property <[MessageActionItem]> actions: [];

    callback action(int);

    visible: root.shown;
    width: 100%;
    height: 100%;
    background: Colors.bg-overlay;

    function level-color() -> color {
        return root.level == 2 ? Colors.text-error : root.level == 1 ? Colors.text-warn : Colors.accent;
    }

    function level-icon() -> string {
        return root.level == 2 ? "⛔" : root.level == 1 ? "⚠" : "ℹ";
    }

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { }
        scroll-event(event) => {
            EventResult.accept
        }
    }

    dialog := Rectangle {
        width: 440px;
        height: 260px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        background: Colors.bg-surface;
        border-radius: 8px;
        border-width: 1px;
        border-color: Colors.border-default;

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            // Пересобирается при каждом показе (как диалог настроек): забирает
            // фокус заново, иначе Enter/Esc уйдут в последний сфокусированный
            // виджет главного окна.
            if root.shown: FocusScope {
                init => { self.focus(); }
                key-pressed(event) => {
                    if (root.actions.length == 0) { return accept; }
                    if (event.text == Key.Return) { root.action(root.actions[0].action-id); return accept; }
                    if (event.text == Key.Escape) { root.action(root.actions[root.actions.length - 1].action-id); return accept; }
                    return accept;
                }

                VerticalLayout {
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: root.level-icon();
                            color: root.level-color();
                            font-size: 20px;
                        }

                        Text {
                            text: root.title;
                            color: root.level-color();
                            font-size: 16px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        background: Colors.bg-window;
                        border-radius: 4px;
                        ScrollView {
                            VerticalLayout {
                                padding: 8px;
                                Text {
                                    text: root.body;
                                    color: Colors.text-primary;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        for item in root.actions : Button {
                            text: item.label;
                            preferred-height: 28px;
                            clicked => { root.action(item.action-id); }
                        }
                    }
                }
            }
        }
    }
}
