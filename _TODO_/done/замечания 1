### Решение #5: Double-buffering ModelRc для Slint

**Файл**: `/workspace/src/app/visualizer_manager.rs`

```rust
use slint::{ModelRc, VecModel};
use std::sync::Arc;

/// Двойной буфер для полос спектра
pub struct SpectrumBuffer {
    front: Arc<VecModel<f32>>,  // То, что видит UI
    back: Vec<f32>,              // То, куда пишем новые данные
    swapped: AtomicBool,
}

impl SpectrumBuffer {
    pub fn new(bands: usize) -> Self {
        let front = Arc::new(VecModel::from(vec![0.0f32; bands]));
        let back = vec![0.0f32; bands];
        Self {
            front,
            back,
            swapped: AtomicBool::new(false),
        }
    }

    /// Записать новые данные в back buffer
    pub fn write(&mut self, values: &[f32]) {
        self.back.copy_from_slice(values);
        self.swapped.store(true, Ordering::Relaxed);
    }

    /// Атомарно поменять буферы местами (вызывать из UI потока)
    pub fn swap(&mut self) -> ModelRc<f32> {
        if self.swapped.swap(false, Ordering::Relaxed) {
            // Создаём новый ModelRc из back buffer
            let new_front = Arc::new(VecModel::from(self.back.clone()));
            let old_front = std::mem::replace(&mut self.front, new_front);
            ModelRc::from_rc(old_front)
        } else {
            ModelRc::from_rc(self.front.clone())
        }
    }
}
```

**Использование**:

```rust
