### Решение #1: Canvas вместо for-each в Slint

**Файл**: `/workspace/ui/visualizer.slint`

```slint
// ✅ ХОРОШО: Canvas рисует все полосы за один проход
component SpectrumBarsCanvas inherits Canvas {
    in property <[float]> values: [];
    in property <color> bar-color: Colors.viz-2;

    horizontal-stretch: 1;
    height: 100%;
    width: 100%;

    // Рисуем при изменении values или размера
    on_changed: {
        canvas.request_redraw();
    }

    // Отрисовка через callback
    callback draw_bars(canvas: item-ref);
}
```

**Rust-интеграция** (`/workspace/src/app/visualizer_manager.rs`):

```rust
// ✅ Преобразуем [f32] в Geometry для Canvas
fn render_spectrum_to_canvas(
    canvas: &slint::CanvasHandle,
    values: &[f32],
    width: f32,
    height: f32,
) {
    let n_bars = values.len();
    let gap = 2.0;
    let bar_width = (width - gap * (n_bars as f32 - 1.0)) / n_bars as f32;

    canvas.set_path_geometry(&{
        let mut paths = Vec::new();
        for (i, &val) in values.iter().enumerate() {
            let x = i as f32 * (bar_width + gap);
            let bar_height = val.clamp(0.0, 1.0) * height;
            let y = height - bar_height;

            // Прямоугольник полосы с скруглением
            let rect = slint::PathElement::Rectangle {
                top_left: slint::LogicalPosition::new(x, y),
                size: slint::LogicalSize::new(bar_width, bar_height),
                radius: 2.0,
            };
            paths.push(rect);
        }
        paths
    });
}
```

**Выгода**:
- 0 аллокаций на кадр
- 2-3× быстрее рендер
- Меньше нагрузка на layout engine

