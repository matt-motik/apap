// ✅ ХОРОШО: Статический LUT на 256 цветов для каждой палитры
use std::sync::OnceLock;

#[derive(Clone, Copy)]
pub struct PaletteLut {
    pub data: [[u8; 4]; 256], // RGBA для прямой записи в буфер
}

static MAGMA_LUT: OnceLock<PaletteLut> = OnceLock::new();
static VIRIDIS_LUT: OnceLock<PaletteLut> = OnceLock::new();
// ... другие палитры

fn build_lut(hex: &str) -> PaletteLut {
    let rgb = parse_hex(hex);
    let mut data = [[0u8; 4]; 256];
    for (i, color) in rgb.iter().enumerate() {
        data[i] = [color[0], color[1], color[2], 255]; // RGBA
    }
    PaletteLut { data }
}

/// Мгновенный lookup цвета (O(1), 0 аллокаций)
#[inline]
pub fn get_palette_color(palette: Palette, t: f32) -> [u8; 4] {
    let idx = ((t * 255.0) as usize).min(255);
    match palette {
        Palette::Magma => MAGMA_LUT.get_or_init(|| build_lut(MAGMA_HEX)).data[idx],
        Palette::Viridis => VIRIDIS_LUT.get_or_init(|| build_lut(VIRIDIS_HEX)).data[idx],
        // ... остальные
        Palette::Solid => [203, 166, 247, 255], // fg_color по умолчанию
    }
}
```

